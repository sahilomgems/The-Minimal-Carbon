<style>
	/* ========== MEGA MENU STYLES ========== */
	.megamenu-products {
	  padding: 0 5px;
	}
  
	.megamenu-products .megamenu-heading {
	  font-size: 14px;
	  font-weight: 600;
	  color: #000;
	  margin-bottom: 10px;
	  text-transform: uppercase;
	  letter-spacing: 0.5px;
	  border-bottom: 1px solid #eee;
	  padding-bottom: 8px;
	}
  
	.megamenu-products .menu-list {
	  list-style: none;
	  margin: 0 !important;
	  padding: 0 !important;
	}
  
	.megamenu-products .menu-list .menu__item {
	  margin: 0 !important;
	  padding: 0 !important;
	}
  
	.megamenu-products .menu-list .menu__item > a {
	  display: block;
	  padding: 6px 0 !important;
	  font-size: 14px;
	  color: #333;
	  text-decoration: none;
	  transition: color 0.2s ease;
	}
  
	.megamenu-products .menu-list .menu__item > a:hover {
	  color: #000;
	}
  
	.megamenu-products .menu-list .menu__item > a .menu-item-icon {
	  margin-right: 8px;
	  vertical-align: middle;
	}
  
	/* ========== SUB-MENU (NESTED ITEMS) ========== */
	.megamenu-products .menu-list .menu__item.has-children {
	  position: relative;
	}
  
	/* Desktop hover - sub-menu to the right */
	@media (min-width: 768px) {
	  .megamenu-products .menu-list .menu__item.has-children > .sub-menu {
		display: none;
		position: absolute;
		left: 100%;
		top: 0;
		margin: 0 !important;
		padding: 10px 0 !important;
		background: #fff;
		min-width: 220px;
		box-shadow: 0 5px 20px rgba(0,0,0,0.1);
		list-style: none;
		z-index: 10;
		border: 1px solid #eee;
	  }
  
	  .megamenu-products .menu-list .menu__item.has-children:hover > .sub-menu {
		display: block;
		position: absolute;
		left: 75%;
	  }
  
	  .megamenu-products .menu-list .menu__item.has-children > .sub-menu li {
		padding: 0;
		margin: 0 !important;
	  }
  
	  .megamenu-products .menu-list .menu__item.has-children > .sub-menu li a {
		display: block;
		padding: 6px 20px;
		font-size: 13px;
		color: #555;
		text-decoration: none;
		transition: all 0.2s ease;
	  }
  
	  .megamenu-products .menu-list .menu__item.has-children > .sub-menu li a:hover {
		color: #000;
		background: #f5f5f5;
	  }
	}
  
	/* ========== MOBILE STYLES ========== */
	@media (max-width: 767px) {
	  .megamenu-products .megamenu-heading {
		font-size: 13px;
		margin-top: 15px;
	  }
  
	  .megamenu-products .menu-list .menu__item > a {
		padding: 8px 0 !important;
		font-size: 14px;
	  }
  
	  .megamenu-products .menu-list .menu__item.has-children > .sub-menu {
		display: none;
		position: relative;
		left: auto;
		top: auto;
		margin: 0 0 0 15px !important;
		padding: 5px 0 !important;
		background: transparent;
		box-shadow: none;
		min-width: auto;
		border: none;
	  }
  
	  .megamenu-products .menu-list .menu__item.has-children > .sub-menu.open {
		display: block;
	  }
  
	  .megamenu-products .menu-list .menu__item.has-children > .sub-menu li a {
		padding: 6px 0 6px 15px;
		font-size: 13px;
		color: #666;
	  }
  
	  /* Toggle icon */
	  .megamenu-products .menu-list .menu__item.has-children > a {
		position: relative;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-right: 30px !important;
	  }
  
	  .megamenu-products .menu-list .menu__item.has-children > a::after {
		content: '+';
		position: absolute;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		font-size: 18px;
		font-weight: 300;
		color: #999;
		transition: transform 0.3s ease;
	  }
  
	  .megamenu-products .menu-list .menu__item.has-children.open > a::after {
		content: '−';
		transform: translateY(-50%) scale(1.2);
		color: #333;
	  }
  
	  /* Sub-menu item with child indicator */
	  .megamenu-products .menu-list .menu__item.has-children > .sub-menu .has-children > a::after {
		content: '›';
		position: absolute;
		right: 5px;
		top: 50%;
		transform: translateY(-50%);
		font-size: 16px;
	  }
	}
  
	/* ========== LAYOUT FOR MULTI-COLUMN VIEW ========== */
	@media (min-width: 768px) {
	  .megamenu-products .menu-row-custom {
		display: flex;
		flex-wrap: wrap;
		gap: 30px;
	  }
  
	  .megamenu-products .menu-row-custom .menu-col {
		flex: 1;
		min-width: 180px;
	  }
  
	  .megamenu-products .menu-row-custom .menu-col .megamenu-heading {
		font-size: 14px;
		font-weight: 600;
		color: #000;
		margin-bottom: 10px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		border-bottom: 1px solid #eee;
		padding-bottom: 8px;
	  }
  
	  .megamenu-products .menu-row-custom .menu-col .menu-list .menu__item > a {
		padding: 4px 0 !important;
		font-size: 13px;
		color: #555;
	  }
  
	  .megamenu-products .menu-row-custom .menu-col .menu-list .menu__item > a:hover {
		color: #000;
	  }
  
	  /* View All button */
	  .megamenu-products .view-all-link {
		display: inline-block;
		margin-top: 8px;
		font-size: 13px;
		font-weight: 600;
		color: #000;
		text-decoration: none;
		border-bottom: 2px solid #000;
		padding-bottom: 2px;
	  }
  
	  .megamenu-products .view-all-link:hover {
		color: #666;
		border-bottom-color: #666;
	  }
	}
  </style>
  
  {%- assign menu_heading = block.settings.menu_heading -%}
  
  {%- if block.settings.widget == 'menu' -%}
	{%- assign menu_link_list = block.settings.menu_link_list_child -%}
	<div class="megamenu-products">
	  {%- if menu_heading != blank -%}
		<div class="megamenu-heading">
		  <span>{{ menu_heading }}</span>
		</div>
	  {%- endif -%}
	  {%- if menu_link_list != blank -%}
		{%- assign linklist = linklists[menu_link_list] -%}
  
		{%- if linklist.links.size == 1 and linklist.links.first.links.size > 0 -%}
		  {%- comment %} If the linklist has a single parent with children, show children directly {%- endcomment %}
		  {%- assign parent_link = linklist.links.first -%}
		  <ul class="menu-list">
			{%- for link in parent_link.links -%}
			  <li class="menu__item{% if link.links.size > 0 %} has-children{% endif %}">
				<a href="{{ link.url }}">
				  {{ link.title }}
				</a>
				{%- if link.links.size > 0 -%}
				  <ul class="sub-menu">
					{%- for child in link.links -%}
					  <li>
						<a href="{{ child.url }}">{{ child.title }}</a>
					  </li>
					{%- endfor -%}
				  </ul>
				{%- endif -%}
			  </li>
			{%- endfor -%}
		  </ul>
		{%- else -%}
		  {%- comment %} Original: show links normally {%- endcomment %}
		  <ul class="menu-list">
			{%- for link in linklist.links -%}
			  {%- assign link_title = link.title | downcase -%}
			  <li class="menu__item{% if link.links.size > 0 %} has-children{% endif %}">
				<a class="menu__link{% if link_title == 'view all' %} view-all-link{% endif %}" href="{{ link.url }}">
				  {{ link.title }}
				</a>
				{%- if link.links.size > 0 -%}
				  <ul class="sub-menu">
					{%- for child in link.links -%}
					  <li>
						<a href="{{ child.url }}">{{ child.title }}</a>
					  </li>
					{%- endfor -%}
				  </ul>
				{%- endif -%}
			  </li>
			{%- endfor -%}
		  </ul>
		{%- endif -%}
	  {%- endif -%}
	</div>
  
  {%- elsif block.settings.widget == 'image' -%}
	<div class="megamenu-banner">
	  <a href="{{ block.settings.banner_link }}">
		{%- if block.settings.image -%}
		  {% include 'img-global' with image, image: block.settings.image, class: "img-fluid", effect: "fade-in" %}
		{%- else -%}
		  <img class="lazyload fade-in" src="https://placehold.jp/330x390.png" width="330" height="390">
		{%- endif -%}
	  </a>
	  <div class="content">
		{%- if block.settings.banner_button != blank -%}
		  <a class="button" href="{{ block.settings.banner_link }}">{{ block.settings.banner_button }}</a>
		{%- endif -%}
	  </div>
	  {%- if block.settings.banner_title != blank -%}
		<h2 class="title">
		  <a href="{{ block.settings.banner_link }}">{{ block.settings.banner_title }}</a>
		</h2>
	  {%- endif -%}
	</div>
  
  {%- elsif block.settings.widget == 'blog' -%}
	{%- if menu_heading != blank -%}
	  <div class="megamenu-heading">
		<span>{{ menu_heading }}</span>
	  </div>
	{%- endif -%}
	<div class="megamenu-blog">
	  {%- for article in block.settings.blog_widget.articles limit: 3 -%}
		<div class="featured-blog__post">
		  <div class="article__image">
			<a class="article__featured-image-link" href="{{ article.url }}">
			  {% include 'img-global' with image, image: article.image, class: "img-fluid", effect: "fade-in" %}
			</a>
		  </div>
		  <div class="article__content">
			<div class="blog-category">
			  <a href="{{ block.settings.blog_widget.url }}">{{ block.settings.blog_widget.title }}</a>
			</div>
			<h2 class="article__heading">
			  <a class="article__heading-link" href="{{ article.url }}">{{ article.title }}</a>
			</h2>
			<div class="meta">
			  <span class="article__meta-comment"
				><a href="#comments">{{ 'blogs.comments.with_count' | t: count: article.comments_count }}</a></span
			  >
			</div>
		  </div>
		</div>
	  {%- endfor -%}
	</div>
  
  {%- elsif block.settings.widget == 'product' -%}
	{%- if menu_heading != blank -%}
	  <div class="megamenu-heading">
		<span>{{ menu_heading }}</span>
	  </div>
	{%- endif -%}
	<div class="megamenu-product">
	  {%- if block.settings.banner_title -%}
		<h2 class="title">{{ block.settings.banner_title }}</h2>
	  {%- endif -%}
	  <div class="wpbingo-section__content bwp_slider-carousel">
		<div
		  class="js-carousel slick-carousel"
		  data-nav="false"
		  data-columns="2"
		  data-column1440="2"
		  data-column1="2"
		  data-column2="2"
		  data-column3="1"
		  data-column4="1"
		>
		  {%- for product in collections[block.settings.collection_widget].products limit: 3 -%}
			<div class="slick-carousel__item">
			  {% include 'product-grid-item' %}
			</div>
		  {%- endfor -%}
		</div>
	  </div>
	</div>
  {%- endif -%}
  
  <script>
	// Mobile toggle for sub-menu
	document.addEventListener('DOMContentLoaded', function () {
	  function initMobileToggle() {
		if (window.innerWidth > 767) return;
  
		document.querySelectorAll('.megamenu-products .menu-list .menu__item.has-children').forEach(function (item) {
		  var link = item.querySelector('a.menu__link');
		  if (!link) return;
  
		  // Remove old event listeners by cloning
		  var newLink = link.cloneNode(true);
		  link.parentNode.replaceChild(newLink, link);
  
		  newLink.addEventListener('click', function (e) {
			e.preventDefault();
			var parent = this.closest('.menu__item.has-children');
			if (parent) {
			  parent.classList.toggle('open');
			  var sub = parent.querySelector('.sub-menu');
			  if (sub) {
				sub.classList.toggle('open');
			  }
			}
		  });
  
		  // If parent has open class, ensure sub-menu is open
		  if (item.classList.contains('open')) {
			var sub = item.querySelector('.sub-menu');
			if (sub) sub.classList.add('open');
		  }
		});
	  }
  
	  initMobileToggle();
  
	  // Re-run on resize
	  window.addEventListener('resize', function () {
		if (window.innerWidth > 767) {
		  document.querySelectorAll('.megamenu-products .menu-list .menu__item.has-children.open').forEach(function (el) {
			el.classList.remove('open');
			var sub = el.querySelector('.sub-menu');
			if (sub) sub.classList.remove('open');
		  });
		} else {
		  initMobileToggle();
		}
	  });
	});
  </script>
