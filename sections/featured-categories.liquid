<section
  class="featured-categories-section"
  style="
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  "
>
  <div class="featured-container">

    <div class="section-heading">
      <h2>
        <span class="title-white">Featured</span>
        <span class="title-gold">Categories</span>
      </h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="categories-grid">
      {% for block in section.blocks %}
        <div class="category-card" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}">
            
            <div class="card-image-wrapper">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy"
                >
              {% endif %}
            </div>

            <div class="card-content">
              <h3>
                {% assign words = block.settings.title | split: ' ' %}

                {% if words.size > 1 %}
                  {% for word in words %}
                    {% if forloop.last %}
                      <span class="title-last-word">{{ word }}</span>
                    {% else %}
                      {{ word }}
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {{ block.settings.title }}
                {% endif %}
              </h3>
            </div>

          </a>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="section-button">
        <a href="{{ section.settings.button_link }}" class="btn-view-all">
          {{ section.settings.button_text }} →
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
.featured-categories-section {
  padding: 60px 0;
  position: relative;
}

.featured-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Heading */
.section-heading {
  text-align: center;
  margin-bottom: 55px;
}

.section-heading h2 {
  font-family: "Times New Roman", serif;
  font-size: 72px;
  font-weight: 500;
  margin: 0;
  line-height: 1.1;
}

.title-white {
  color: #ffffff;
}

.title-gold {
  color: #d49a6a;
  position: relative;
}

{% comment %} .title-gold::before {
  content: "✦";
  position: absolute;
  top: -12px;
  left: -14px;
  font-size: 14px;
  color: #d49a6a;
} {% endcomment %}

.section-heading p {
  margin-top: 14px;
  font-size: 18px;
  color: #ffffff;
  position: relative;
  display: inline-block;
  padding: 0 55px;
}

.section-heading p::before,
.section-heading p::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 42px;
  height: 1px;
  background: #d49a6a;
}

.section-heading p::before {
  left: 0;
}

.section-heading p::after {
  right: 0;
}

/* Grid */
.categories-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

/* Card */
.category-card {
  border: 2px solid rgba(255,255,255,0.8);
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
  background: transparent;
}

.category-card:hover {
  transform: translateY(-5px);
}

.category-card a {
  text-decoration: none;
  display: block;
}

.card-image-wrapper {
  height: 300px;
  overflow: hidden;
}

.category-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Bottom title */
.card-content {
  background: #f4f4f4;
  padding: 14px 10px;
  min-height: 84px;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.card-content h3 {
  font-size: 18px;
  color: #1c1c1c;
  margin: 0;
  font-family: "Times New Roman", serif;
  font-weight: 600;
  line-height: 1.25;
  min-height: 48px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Last word gold */
.title-last-word {
  {% comment %} display: block; {% endcomment %}
  {% comment %} color: #d49a6a; {% endcomment %}
}

/* Underline */
.card-content h3::after {
  content: "";
  display: block;
  width: 42px;
  height: 1px;
  background: #d49a6a;
  margin: 6px auto 0;
}

/* Button */
.section-button {
  text-align: center;
  margin-top: 40px;
}

.btn-view-all {
  display: inline-block;
  padding: 14px 34px;
  border: 1px solid #d49a6a;
  border-radius: 30px;
  color: #d49a6a;
  text-decoration: none;
  font-size: 16px;
  transition: 0.3s;
}

.btn-view-all:hover {
  background: #d49a6a;
  color: #fff;
}

/* Tablet */
@media screen and (max-width: 991px) {
  .categories-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .section-heading h2 {
    font-size: 50px;
  }

  .card-image-wrapper {
    height: 240px;
  }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .featured-categories-section {
    padding: 40px 0;
  }

  .featured-container {
    padding: 0 15px;
  }

  .section-heading h2 {
    font-size: 42px;
  }

  .section-heading p {
    font-size: 14px;
    padding: 0 35px;
  }

  .section-heading p::before,
  .section-heading p::after {
    width: 24px;
  }

  .categories-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .card-image-wrapper {
    height: 280px;
  }

  .card-content h3 {
    font-size: 16px;
  }

  .btn-view-all {
    padding: 12px 24px;
    font-size: 14px;
  }
}
</style>

{% schema %}
{
  "name": "Featured Categories",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Explore our finest craftsmanship, curated for your special moments."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#02143a"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View All Categories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Category Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Featured Categories"
    }
  ]
}
{% endschema %}