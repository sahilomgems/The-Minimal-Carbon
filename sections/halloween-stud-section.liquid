{% comment %}
  🎃 Halloween Stud Section
  Fully customizable Shopify section with editable text, button, and images.
  Includes background images for desktop, tablet, and mobile.
{% endcomment %}

<section id="halloween-stud-{{ section.id }}" class="halloween-stud-section">
  <div class="custom-stud-container">
    <!-- Background banners -->
    <div class="custom-stud-bg-banner">
      <div class="custom-banner-desktop">
        {% if section.settings.bg_image_desktop != blank %}
          <img class="csd-bg-banner-image-desktop"
               src="{{ section.settings.bg_image_desktop | image_url: width: 2000 }}"
               alt="Desktop Banner">
        {% endif %}
      </div>

      <div class="custom-banner-tablet">
        {% if section.settings.bg_image_tablet != blank %}
          <img class="csd-bg-banner-image-tablet"
               src="{{ section.settings.bg_image_tablet | image_url: width: 1500 }}"
               alt="Tablet Banner">
        {% endif %}
      </div>

      <div class="custom-banner-mobile">
        {% if section.settings.bg_image_mobile != blank %}
          <img class="csd-bg-banner-image-mobile"
               src="{{ section.settings.bg_image_mobile | image_url: width: 1000 }}"
               alt="Mobile Banner">
        {% endif %}
      </div>
    </div>

    <!-- Content -->
    <div class="csd-main-contain-par">
      <div class="csd-main-inner-info">
        <div class="csd-heading-main reveal-y" data-delay="0">
          <h2 class="csd-heading">{{ section.settings.heading }}</h2>
          {% if section.settings.heading_image %}
            <img class="csd-image-heading"
                 src="{{ section.settings.heading_image | image_url: width: 800 }}"
                 alt="Heading Image">
          {% endif %}
        </div>

        {% if section.settings.text != blank %}
          <p class="csd-text reveal-y" data-delay="150">
            {{ section.settings.text }}
          </p>
        {% endif %}

        <div class="csd-button-main">
          {% if section.settings.button_link and section.settings.button_text %}
            <a class="csd-button reveal-y" id="csd-button" data-delay="300"
               href="{{ section.settings.button_link }}">
              {{ section.settings.button_text }}
            </a>
          {% endif %}

          {% if section.settings.button_image %}
            <img class="csd-image-button"
                 src="{{ section.settings.button_image | image_url: width: 600 }}"
                 alt="Button Image">
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Optional inner gif -->
    {% if section.settings.inner_gif %}
      <div class="csd-banner-inner-image">
        <img class="banner-inner-gif"
             src="{{ section.settings.inner_gif | image_url: width: 800 }}"
             alt="Inner Gif">
      </div>
    {% endif %}

    <!-- Pumpkin Eyes -->
    {% if section.settings.eye_image %}
      <img class="csd-pump-eye"
           src="{{ section.settings.eye_image | image_url: width: 200 }}"
           alt="Pumpkin Eye">
    {% endif %}
    {% if section.settings.eye_image_second %}
      <img class="csd-pump-eye-second"
           src="{{ section.settings.eye_image_second | image_url: width: 200 }}"
           alt="Pumpkin Eye Second">
    {% endif %}
  </div>
</section>

<!-- Styles -->
<style>
/* ==============================
   🎃 Halloween Stud Section Styles
   ============================== */

.halloween-stud-section {
  position: relative;
  width: 100%;
  overflow: hidden;
  background-color: #000; /* Fallback */
  color: #fff;
  font-family: 'Poppins', sans-serif;
}

.custom-stud-container {
  position: relative;
  width: 100%;
  height: 100%;
}

/* ------------------------------
   Background Banners
------------------------------ */
.custom-stud-bg-banner {
  position: relative;
  width: 100%;
  height: 100%;
}

.custom-stud-bg-banner img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

/* Hide/Show images by screen size */
.custom-banner-desktop,
.custom-banner-tablet,
.custom-banner-mobile {
  display: none;
}

@media (min-width: 1181px) {
  .custom-banner-desktop { display: block; }
}
@media (max-width: 1180px) and (min-width: 769px) {
  .custom-banner-tablet { display: block; }
}
@media (max-width: 768px) {
  .custom-banner-mobile { display: block; }
}

/* ------------------------------
   Main Content
------------------------------ */
.csd-main-contain-par {
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 2rem;
}

.csd-main-inner-info {
  max-width: 700px;
  z-index: 2;
}

.csd-heading-main {
  position: relative;
  margin-bottom: 1rem;
}

.csd-heading {
    color: #ff7e00;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
    margin: 0;
    position: absolute;
    top: 50%;
    font-size: 21px;
    left: 28%;
}

.csd-image-heading {
    max-width: 400px;
    margin: 0 auto;
    display: block;
}

.csd-text {
  font-size: 1rem;
  line-height: 1.6;
  margin: 0 auto 2rem;
  color: #f2f2f2;
  opacity: 0.9;
}

/* ------------------------------
   Button Styles
------------------------------ */
.csd-button-main {
  position: relative;
  display: inline-block;
}

.csd-button {
  display: inline-block;
  background-color: #ff7e00;
  color: #000;
  text-transform: uppercase;
  font-weight: 600;
  padding: 0.9rem 2rem;
  border-radius: 40px;
  text-decoration: none;
  transition: all 0.3s ease;
  position: relative;
  z-index: 2;
}

.csd-button:hover {
  background-color: #fff;
  color: #000;
  box-shadow: 0 0 20px #ff7e00;
}

.csd-image-button {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 120%;
  max-width: 400px;
  transform: translate(-50%, -50%);
  z-index: 1;
  opacity: 0.6;
  pointer-events: none;
}

/* ------------------------------
   Decorative Images
------------------------------ */
.csd-banner-inner-image {
  position: absolute;
  bottom: 5%;
  right: 8%;
  z-index: 1;
}

.csd-banner-inner-image img {
  width: 120px;
  animation: floatY 3s ease-in-out infinite;
}

@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.csd-pump-eye,
.csd-pump-eye-second {
  position: absolute;
  width: 60px;
  animation: glowPulse 2s ease-in-out infinite alternate;
}

.csd-pump-eye {
  top: 25%;
  left: 20%;
}

.csd-pump-eye-second {
  top: 25%;
  right: 20%;
}

@keyframes glowPulse {
  0% { filter: drop-shadow(0 0 0 #ff7e00); }
  100% { filter: drop-shadow(0 0 15px #ff7e00); }
}

/* ------------------------------
   Animation (Reveal on Scroll)
------------------------------ */
.reveal-y {
  opacity: 0;
  transform: translateY(40px);
  transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: var(--csd-delay, 0ms);
}

.reveal-y.in-view {
    opacity: 1;
    transform: translateY(0);
    position: relative;
    max-width: 350px;
    font-family: cursive;
    font-size: 32px;
}

/* ------------------------------
   Responsive Adjustments
------------------------------ */
@media (max-width: 768px) {
  .csd-heading { font-size: 1.8rem; }
  .csd-text { font-size: 0.9rem; }
  .csd-banner-inner-image img { width: 90px; }
  .csd-pump-eye, .csd-pump-eye-second { width: 40px; }
}

</style>

<!-- Script -->
<script>
  (function () {
    var sectionEl = document.getElementById('halloween-stud-{{ section.id }}');
    var DESKTOP_QUERY = '(min-width: 1181px)';

    function revealInit(sectionEl, animateEnabled) {
      if (!sectionEl) return;
      var els = sectionEl.querySelectorAll('.reveal-y');
      if (!els.length) return;

      function show(el) {
        var delay = el.getAttribute('data-delay');
        if (delay) el.style.setProperty('--csd-delay', delay + 'ms');
        el.classList.add('in-view');
      }

      if (!animateEnabled || !('IntersectionObserver' in window)) {
        els.forEach(show);
        return;
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            show(entry.target);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      els.forEach(function (el) { io.observe(el); });
    }

    function run() {
      revealInit(sectionEl, window.matchMedia(DESKTOP_QUERY).matches);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === '{{ section.id }}') run();
    });
  })();
</script>

{% schema %}
{
  "name": "🎃 Halloween Stud Section",
  "settings": [
    { "type": "image_picker", "id": "bg_image_desktop", "label": "Background Image (Desktop)" },
    { "type": "image_picker", "id": "bg_image_tablet", "label": "Background Image (Tablet)" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Background Image (Mobile)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Halloween Studs" },
    { "type": "image_picker", "id": "heading_image", "label": "Heading Image" },
    { "type": "text", "id": "text", "label": "Description", "default": "Get your spooky custom lab diamond stud earrings that last forever!" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    { "type": "image_picker", "id": "button_image", "label": "Button Image" },
    { "type": "image_picker", "id": "inner_gif", "label": "Inner GIF (optional)" },
    { "type": "image_picker", "id": "eye_image", "label": "Left Eye Image (optional)" },
    { "type": "image_picker", "id": "eye_image_second", "label": "Right Eye Image (optional)" }
  ],
  "presets": [
    { "name": "🎃 Halloween Stud Banner", "category": "Seasonal Sections" }
  ]
}
{% endschema %}
