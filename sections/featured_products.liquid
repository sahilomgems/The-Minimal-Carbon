<section
  class="featured-products-section"
  style="
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  "
>
  <div class="featured-container">

    <div class="section-heading">
      <h2>
        <span class="title-white">{{ section.settings.heading }}</span>
      </h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="products-grid">
      {% for block in section.blocks %}
        {% assign selected_product = block.settings.product %}
        <div class="product-card" {{ block.shopify_attributes }}>
          <a href="{{ selected_product.url }}">

            <div class="card-image-wrapper">
              {% if block.settings.custom_image != blank %}
                {{
                  block.settings.custom_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    alt: selected_product.title
                }}
              {% elsif selected_product.featured_image != blank %}
                {{
                  selected_product.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    alt: selected_product.title
                }}
              {% endif %}
            </div>

            <div class="card-content">
              <h3>
                {% if block.settings.custom_title != blank %}
                  {{ block.settings.custom_title }}
                {% else %}
                  {{ selected_product.title }}
                {% endif %}
              </h3>

              <div class="product-price">
                {{ selected_product.price | money }}
              </div>
            </div>

          </a>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="section-button">
        <a href="{{ section.settings.button_link }}" class="btn-view-all">
          {{ section.settings.button_text }} →
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
.featured-products-section {
  padding: 60px 0;
  position: relative;
}

.featured-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Heading */
.section-heading {
  text-align: center;
  margin-bottom: 55px;
}

.section-heading h2 {
  font-family: "Times New Roman", serif;
  font-size: 64px;
  font-weight: 500;
  margin: 0;
  line-height: 1.1;
}

.title-white {
  color: #ffffff;
}

.section-heading p {
  margin-top: 14px;
  font-size: 18px;
  color: #ffffff;
  position: relative;
  display: inline-block;
  padding: 0 55px;
}

.section-heading p::before,
.section-heading p::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 42px;
  height: 1px;
  background: #d49a6a;
}

.section-heading p::before {
  left: 0;
}

.section-heading p::after {
  right: 0;
}

/* Grid */
.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

/* Card */
.product-card {
  border: 2px solid rgba(255,255,255,0.8);
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
  background: transparent;
}

.product-card:hover {
  transform: translateY(-5px);
}

.product-card a {
  text-decoration: none;
  display: block;
}

.card-image-wrapper {
  height: 260px;
  overflow: hidden;
}

.card-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Content */
.card-content {
  background: #f4f4f4;
  padding: 12px 10px 14px;
  text-align: center;
  min-height: 92px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-content h3 {
  font-size: 16px;
  color: #1c1c1c;
  margin: 0 0 6px;
  font-family: "Times New Roman", serif;
  font-weight: 600;
  line-height: 1.2;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 38px;
}

.product-price {
  font-size: 16px;
  color: #d49a6a;
  font-family: "Times New Roman", serif;
  font-weight: 600;
  line-height: 1;
}

/* Button */
.section-button {
  text-align: center;
  margin-top: 40px;
}

.btn-view-all {
  display: inline-block;
  padding: 14px 34px;
  border: 1px solid #d49a6a;
  border-radius: 30px;
  color: #d49a6a;
  text-decoration: none;
  font-size: 16px;
  transition: 0.3s;
}

.btn-view-all:hover {
  background: #d49a6a;
  color: #fff;
}

/* Tablet */
@media screen and (max-width: 991px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .section-heading h2 {
    font-size: 48px;
  }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .featured-products-section {
    padding: 40px 0;
  }

  .featured-container {
    padding: 0 15px;
  }

  .products-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .section-heading h2 {
    font-size: 38px;
  }

  .section-heading p {
    font-size: 14px;
    padding: 0 35px;
  }

  .card-image-wrapper {
    height: 280px;
  }

  .card-content h3 {
    font-size: 15px;
  }

  .product-price {
    font-size: 15px;
  }
}
</style>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Most Loved Pieces"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Handpicked favorites, crafted to be treasured forever."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#02143a"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View All Categories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Product Title"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Product Image"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}