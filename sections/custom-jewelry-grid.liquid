{% schema %}
{
  "name": "Custom Jewelry Grid",
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fine Jewelry"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Discover statement-making pieces"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Custom Jewelry Grid"
    }
  ]
}
{% endschema %}

<section class="jewelry-grid-section">
  <div class="jewelry-grid">
    {% for block in section.blocks %}
      <div class="jewelry-card">
        {% if block.settings.card_image %}
          <img
            src="{{ block.settings.card_image | image_url: width: 1200 }}"
            alt="{{ block.settings.heading }}"
          >
        {% endif %}

        <div class="overlay-content">
          <h2>{{ block.settings.heading }}</h2>
          <p>{{ block.settings.subtext }}</p>
          <a href="{{ block.settings.button_link }}" class="shop-btn">
            Shop Now
          </a>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
.jewelry-grid-section {
  padding: 20px;
}

.jewelry-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.jewelry-card {
  position: relative;
  overflow: hidden;
  border-radius: 0px;
  height: 800px; /* BIG HEIGHT */
}

.jewelry-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.overlay-content {
  position: absolute;
  bottom: 40px;
  left: 0;
  right: 0;
  text-align: center;
  color: #fff;
  padding: 20px;
}

.overlay-content h2 {
  font-size: 42px;
  margin-bottom: 10px;
}

.overlay-content p {
  font-size: 18px;
  margin-bottom: 20px;
}

.shop-btn {
  display: inline-block;
  padding: 14px 35px;
  border: 1px solid #fff;
  color: #fff;
  text-decoration: none;
  font-size: 16px;
}

.shop-btn:hover {
  background: #fff;
  color: #000;
}

/* Responsive */
@media screen and (max-width: 991px) {
  .jewelry-grid {
    grid-template-columns: 1fr;
  }

  .jewelry-card {
    height: 500px;
  }

  .overlay-content h2 {
    font-size: 30px;
  }
}
</style>