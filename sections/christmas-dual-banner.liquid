{% comment %}
  Shopify Section: Christmas Dual Promotional Banner
  File: sections/christmas-dual-banner.liquid
{% endcomment %}

<section class="christmas-dual-banner" id="christmas-banner-{{ section.id }}">
  {%- if section.settings.show_snow -%}
  <div class="snow-bokeh-container" aria-hidden="true"></div>
  <div class="fairy-lights" aria-hidden="true">
    {% for i in (1..20) %}
      <div class="light light-{{ i }}"></div>
    {% endfor %}
  </div>
  {%- endif -%}
  
  <div class="container">
    {%- if section.settings.section_title != blank or section.settings.section_subtitle != blank -%}
    <div class="banner-header">
      {%- if section.settings.section_title != blank -%}
        <h2 class="banner-title">
          {%- if section.settings.show_santa_icon -%}
            <span class="title-icon">🎅</span>
          {%- endif -%}
          {{ section.settings.section_title }}
          {%- if section.settings.show_santa_icon -%}
            <span class="title-icon">🎄</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.section_subtitle != blank -%}
        <p class="banner-subtitle">{{ section.settings.section_subtitle }}</p>
      {%- endif -%}
    </div>
    {%- endif -%}
    
    <div class="banners-wrapper">
      <!-- Left Banner: Santa Gift Bag -->
      <div class="banner-card banner-left {% if section.settings.gold_hover %}gold-glow{% endif %}">
        {%- if section.settings.show_ribbon_tag -%}
          <div class="ribbon-tag">
            <span>🎁 Christmas Special</span>
          </div>
        {%- endif -%}
        
        <div class="banner-image-wrapper">
          {%- if section.settings.banner_image_1 -%}
            <img 
              src="{{ section.settings.banner_image_1 | img_url: '800x' }}" 
              alt="{{ section.settings.banner_1_title | escape }}"
              loading="lazy"
              class="banner-image"
            >
          {%- else -%}
            <div class="banner-placeholder">
              <div class="santa-bag-illustration">
                <svg width="200" height="250" viewBox="0 0 200 250" fill="none">
                  <!-- Santa Bag -->
                  <path d="M50 80 Q30 90 40 180 L160 180 Q170 90 150 80 Z" fill="#7a001e" stroke="#d4af37" stroke-width="3"/>
                  <ellipse cx="100" cy="75" rx="50" ry="15" fill="#8b0020"/>
                  <!-- Rope -->
                  <path d="M70 75 Q70 60 100 50 Q130 60 130 75" stroke="#d4af37" stroke-width="4" fill="none"/>
                  <!-- Gifts inside -->
                  <rect x="70" y="110" width="25" height="25" fill="#d4af37" opacity="0.8"/>
                  <rect x="105" y="120" width="20" height="30" fill="#f7f6f2" opacity="0.8"/>
                  <circle cx="85" cy="155" r="12" fill="#d4af37" opacity="0.8"/>
                  <!-- Sparkles -->
                  <circle cx="60" cy="100" r="3" fill="#d4af37"/>
                  <circle cx="140" cy="110" r="2" fill="#d4af37"/>
                  <circle cx="100" cy="95" r="2.5" fill="#d4af37"/>
                </svg>
              </div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.gold_hover -%}
            <div class="gold-shimmer"></div>
          {%- endif -%}
        </div>
        
        <div class="banner-content">
          {%- if section.settings.banner_1_tag != blank -%}
            <div class="content-tag">
              <span class="tag-icon">✨</span>
              {{ section.settings.banner_1_tag }}
            </div>
          {%- endif -%}
          
          {%- if section.settings.banner_1_title != blank -%}
            <h3 class="banner-content-title">{{ section.settings.banner_1_title }}</h3>
          {%- endif -%}
          
          {%- if section.settings.banner_1_text != blank -%}
            <p class="banner-text">{{ section.settings.banner_1_text }}</p>
          {%- endif -%}
          
          {%- if section.settings.banner_1_button_text != blank -%}
            <a href="{{ section.settings.banner_1_button_link }}" class="banner-button">
              {{ section.settings.banner_1_button_text }}
              <span class="button-arrow">→</span>
            </a>
          {%- endif -%}
        </div>
        
        <div class="decorative-icons">
          <span class="deco-icon icon-1">🔔</span>
          <span class="deco-icon icon-2">⭐</span>
        </div>
      </div>
      
      <!-- Right Banner: Luxury Gift Box -->
      <div class="banner-card banner-right {% if section.settings.gold_hover %}gold-glow{% endif %}">
        {%- if section.settings.show_ribbon_tag -%}
          <div class="ribbon-tag">
            <span>🎁 Limited Edition</span>
          </div>
        {%- endif -%}
        
        <div class="banner-image-wrapper gift-box-wrapper">
          {%- if section.settings.banner_image_2 -%}
            <img 
              src="{{ section.settings.banner_image_2 | img_url: '800x' }}" 
              alt="{{ section.settings.banner_2_title | escape }}"
              loading="lazy"
              class="banner-image"
            >
          {%- else -%}
            <div class="banner-placeholder">
              <div class="gift-box-illustration">
                <svg width="200" height="250" viewBox="0 0 200 250" fill="none">
                  <!-- Gift Box Base -->
                  <rect x="50" y="100" width="100" height="80" fill="#7a001e" stroke="#d4af37" stroke-width="3"/>
                  <!-- Box Top -->
                  <rect x="45" y="85" width="110" height="20" fill="#8b0020" stroke="#d4af37" stroke-width="3"/>
                  <!-- Ribbon Vertical -->
                  <rect x="95" y="85" width="10" height="95" fill="#d4af37"/>
                  <!-- Ribbon Horizontal -->
                  <rect x="50" y="120" width="100" height="10" fill="#d4af37"/>
                  <!-- Bow -->
                  <ellipse cx="85" cy="75" rx="15" ry="10" fill="#d4af37"/>
                  <ellipse cx="115" cy="75" rx="15" ry="10" fill="#d4af37"/>
                  <circle cx="100" cy="75" r="8" fill="#d4af37"/>
                  <!-- Sparkles -->
                  <circle cx="40" cy="110" r="3" fill="#d4af37"/>
                  <circle cx="160" cy="130" r="2.5" fill="#d4af37"/>
                  <circle cx="100" cy="65" r="2" fill="#d4af37"/>
                  <!-- Jewelry hint -->
                  <circle cx="100" cy="145" r="8" fill="#d4af37" opacity="0.6"/>
                  <circle cx="100" cy="145" r="5" fill="#f7f6f2"/>
                </svg>
              </div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.gold_hover -%}
            <div class="gold-shimmer"></div>
          {%- endif -%}
        </div>
        
        <div class="banner-content">
          {%- if section.settings.banner_2_tag != blank -%}
            <div class="content-tag">
              <span class="tag-icon">🎁</span>
              {{ section.settings.banner_2_tag }}
            </div>
          {%- endif -%}
          
          {%- if section.settings.banner_2_title != blank -%}
            <h3 class="banner-content-title">{{ section.settings.banner_2_title }}</h3>
          {%- endif -%}
          
          {%- if section.settings.banner_2_text != blank -%}
            <p class="banner-text">{{ section.settings.banner_2_text }}</p>
          {%- endif -%}
          
          {%- if section.settings.banner_2_button_text != blank -%}
            <a href="{{ section.settings.banner_2_button_link }}" class="banner-button">
              {{ section.settings.banner_2_button_text }}
              <span class="button-arrow">→</span>
            </a>
          {%- endif -%}
        </div>
        
        <div class="decorative-icons">
          <span class="deco-icon icon-1">🎀</span>
          <span class="deco-icon icon-2">💎</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
#christmas-banner-{{ section.id }} {
  --color-christmas-red: #7a001e;
  --color-gold: #d4af37;
  --color-frosted-white: #f7f6f2;
}

.christmas-dual-banner {
  position: relative;
  {% comment %} background: linear-gradient(135deg, #f7f6f2 0%, #ffffff 50%, #f7f6f2 100%); {% endcomment %}
  padding: 100px 20px;
  overflow: hidden;
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 10;
}

/* Snow Bokeh Background */
.snow-bokeh-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
  opacity: 0.4;
  background: 
    radial-gradient(circle at 20% 30%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 60%, rgba(212, 175, 55, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 50% 80%, rgba(255, 255, 255, 0.2) 0%, transparent 60%);
}

.snow-bokeh-container::before,
.snow-bokeh-container::after {
  content: '❄';
  position: absolute;
  font-size: 2rem;
  color: rgba(212, 175, 55, 0.3);
  animation: floatSnow 15s ease-in-out infinite;
}

.snow-bokeh-container::before {
  top: 10%;
  left: 15%;
  animation-delay: 0s;
}

.snow-bokeh-container::after {
  top: 60%;
  right: 20%;
  animation-delay: 3s;
}

@keyframes floatSnow {
  0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.3; }
  50% { transform: translateY(-30px) rotate(180deg); opacity: 0.6; }
}

/* Fairy Lights */
.fairy-lights {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.light {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--color-gold);
  box-shadow: 0 0 20px var(--color-gold);
  animation: twinkle 3s ease-in-out infinite;
}

@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.3); }
}

{% for i in (1..20) %}
.light-{{ i }} {
  top: {{ i | times: 4.5 | modulo: 90 }}%;
  left: {{ i | times: 5 | modulo: 95 }}%;
  animation-delay: {{ i | times: 0.15 }}s;
  animation-duration: {{ 2 | plus: i | modulo: 3 }}s;
}
{% endfor %}

/* Banner Header */
.banner-header {
  text-align: center;
  margin-bottom: 64px;
  animation: fadeInDown 1s ease-out;
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-30px); }
  to { opacity: 1; transform: translateY(0); }
}

.banner-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 300;
  color: var(--color-christmas-red);
  margin: 0 0 16px 0;
  letter-spacing: -0.02em;
}

.title-icon {
  display: inline-block;
  font-size: 0.8em;
  margin: 0 12px;
  animation: iconBounce 2s ease-in-out infinite;
}

@keyframes iconBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.banner-subtitle {
  font-size: clamp(1rem, 2vw, 1.25rem);
  color: #666666;
  font-weight: 300;
  margin: 0;
  line-height: 1.6;
}

/* Banners Wrapper */
.banners-wrapper {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 40px;
  perspective: 1000px;
}

/* Banner Card */
.banner-card {
  position: relative;
  background: #ffffff;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(122, 0, 30, 0.12);
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  animation: cardEntrance 1s ease-out both;
}

.banner-left {
  animation-delay: 0.2s;
}

.banner-right {
  animation-delay: 0.4s;
}

@keyframes cardEntrance {
  from {
    opacity: 0;
    transform: translateY(50px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.banner-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 3px solid transparent;
  border-radius: 20px;
  background: linear-gradient(135deg, var(--color-gold), var(--color-christmas-red), var(--color-gold)) border-box;
  -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  opacity: 0.6;
}

.banner-card:hover {
  transform: translateY(-12px) rotateX(2deg);
  box-shadow: 0 20px 60px rgba(122, 0, 30, 0.25);
}

.banner-left:hover {
  transform: translateY(-12px) rotateY(-2deg);
}

.banner-right:hover {
  transform: translateY(-12px) rotateY(2deg);
}

/* Ribbon Tag */
.ribbon-tag {
  position: absolute;
  top: 20px;
  right: -8px;
  background: var(--color-christmas-red);
  color: #ffffff;
  padding: 8px 24px 8px 16px;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  z-index: 20;
  box-shadow: 0 4px 16px rgba(122, 0, 30, 0.4);
  clip-path: polygon(0 0, 100% 0, 95% 50%, 100% 100%, 0 100%);
}

.ribbon-tag::before {
  content: '';
  position: absolute;
  right: 0;
  bottom: -8px;
  width: 0;
  height: 0;
  border-right: 8px solid #5a0015;
  border-bottom: 8px solid transparent;
}

/* Banner Image */
.banner-image-wrapper {
  position: relative;
  height: 400px;
  overflow: hidden;
  background: linear-gradient(135deg, #f7f6f2 0%, #ffffff 100%);
}

.banner-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.banner-card:hover .banner-image {
  transform: scale(1.08);
}

.banner-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.santa-bag-illustration,
.gift-box-illustration {
  animation: itemFloat 3s ease-in-out infinite;
}

.banner-card:hover .santa-bag-illustration {
  animation: bagBounce 0.8s ease-out;
}

@keyframes itemFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

@keyframes bagBounce {
  0%, 100% { transform: scale(1) translateY(0); }
  30% { transform: scale(1.05) translateY(-10px); }
  60% { transform: scale(0.98) translateY(5px); }
}

.gift-box-wrapper:hover .gift-box-illustration {
  animation: giftBoxOpen 1s ease-out;
}

@keyframes giftBoxOpen {
  0% { transform: scale(1) rotateZ(0deg); }
  30% { transform: scale(1.05) rotateZ(-3deg); }
  60% { transform: scale(1.05) rotateZ(3deg); }
  100% { transform: scale(1) rotateZ(0deg); }
}

/* Gold Shimmer Effect */
.gold-shimmer {
  position: absolute;
  top: -100%;
  left: -100%;
  width: 300%;
  height: 300%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(212, 175, 55, 0.4) 50%,
    transparent 70%
  );
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.gold-glow:hover .gold-shimmer {
  opacity: 1;
  animation: shimmerMove 1.5s ease-out;
}

@keyframes shimmerMove {
  0% { transform: translate(-50%, -50%) rotate(45deg); }
  100% { transform: translate(50%, 50%) rotate(45deg); }
}

/* Banner Content */
.banner-content {
  padding: 40px 32px;
  position: relative;
  z-index: 10;
}

.content-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, var(--color-gold), #e6c34a);
  color: #ffffff;
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 16px;
  box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
}

.tag-icon {
  font-size: 14px;
  animation: tagPulse 2s ease-in-out infinite;
}

@keyframes tagPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.banner-content-title {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 600;
  color: var(--color-christmas-red);
  margin: 0 0 16px 0;
  line-height: 1.3;
}

.banner-text {
  font-size: 15px;
  line-height: 1.7;
  color: #666666;
  margin: 0 0 24px 0;
}

/* Banner Button */
.banner-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--color-christmas-red);
  color: #ffffff;
  padding: 14px 32px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.4s ease;
  box-shadow: 0 4px 20px rgba(122, 0, 30, 0.3);
  position: relative;
  overflow: hidden;
}

.banner-button::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.4);
  transform: translate(-50%, -50%);
  transition: width 0.6s ease, height 0.6s ease;
}

.banner-button:hover::before {
  width: 300px;
  height: 300px;
}

.banner-button:hover {
  background: var(--color-gold);
  transform: translateY(-2px);
  box-shadow: 
    0 8px 30px rgba(212, 175, 55, 0.5),
    0 0 40px rgba(212, 175, 55, 0.3);
  animation: buttonGlow 1.5s ease-in-out infinite;
}

@keyframes buttonGlow {
  0%, 100% { box-shadow: 0 8px 30px rgba(212, 175, 55, 0.5); }
  50% { box-shadow: 0 8px 40px rgba(212, 175, 55, 0.8); }
}

.button-arrow {
  transition: transform 0.3s ease;
  position: relative;
  z-index: 1;
}

.banner-button:hover .button-arrow {
  transform: translateX(5px);
}

/* Decorative Icons */
.decorative-icons {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
}

.deco-icon {
  position: absolute;
  font-size: 32px;
  opacity: 0.2;
  animation: iconFloat 4s ease-in-out infinite;
}

.icon-1 {
  top: 15%;
  right: 10%;
  animation-delay: 0s;
}

.icon-2 {
  bottom: 20%;
  left: 8%;
  animation-delay: 1s;
}

@keyframes iconFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20px) rotate(15deg); }
}

.banner-card:hover .deco-icon {
  opacity: 0.4;
  animation-duration: 2s;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .banners-wrapper {
    gap: 32px;
  }
  
  .banner-image-wrapper {
    height: 350px;
  }
  
  .christmas-dual-banner {
    padding: 80px 20px;
  }
}

@media (max-width: 768px) {
  .banners-wrapper {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  
  .banner-card:hover {
    transform: translateY(-8px);
  }
  
  .banner-left:hover,
  .banner-right:hover {
    transform: translateY(-8px);
  }
  
  .banner-image-wrapper {
    height: 300px;
  }
  
  .christmas-dual-banner {
    padding: 60px 16px;
  }
  
  .banner-header {
    margin-bottom: 48px;
  }
}

@media (max-width: 480px) {
  .banner-content {
    padding: 32px 24px;
  }
  
  .banner-button {
    width: 100%;
    justify-content: center;
  }
  
  .ribbon-tag {
    font-size: 11px;
    padding: 6px 20px 6px 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .banner-card,
  .santa-bag-illustration,
  .gift-box-illustration,
  .title-icon,
  .light,
  .deco-icon,
  .tag-icon,
  .banner-button,
  .gold-shimmer {
    animation: none;
  }
  
  .banner-card:hover {
    transform: translateY(-4px);
  }
}
</style>

<script>
(function() {
  const section = document.getElementById('christmas-banner-{{ section.id }}');
  if (!section) return;
  
  const snowContainer = section.querySelector('.snow-bokeh-container');
  
  // Create floating snow particles
  if (snowContainer) {
    for (let i = 0; i < 15; i++) {
      const particle = document.createElement('div');
      particle.className = 'snow-particle';
      particle.style.cssText = `
        position: absolute;
        width: ${3 + Math.random() * 5}px;
        height: ${3 + Math.random() * 5}px;
        background: rgba(212, 175, 55, 0.4);
        border-radius: 50%;
        top: ${Math.random() * 100}%;
        left: ${Math.random() * 100}%;
        animation: particleFloat ${8 + Math.random() * 8}s linear infinite;
        animation-delay: ${Math.random() * 5}s;
        filter: blur(1px);
      `;
      snowContainer.appendChild(particle);
    }
  }
  
  // Add sparkle effect on gift box hover
  const giftBoxes = section.querySelectorAll('.gift-box-wrapper');
  giftBoxes.forEach(box => {
    box.addEventListener('mouseenter', function() {
      for (let i = 0; i < 8; i++) {
        const sparkle = document.createElement('div');
        sparkle.style.cssText = `
          position: absolute;
          width: 4px;
          height: 4px;
          background: var(--color-gold);
          border-radius: 50%;
          top: ${20 + Math.random() * 60}%;
          left: ${20 + Math.random() * 60}%;
          pointer-events: none;
          animation: sparkleEffect 1s ease-out forwards;
          z-index: 100;
        `;
        box.appendChild(sparkle);
        
        setTimeout(() => sparkle.remove(), 1000);
      }
    });
  });
  
  // Parallax effect on scroll
  window.addEventListener('scroll', function() {
    const scrolled = window.pageYOffset;
    const bannerCards = section.querySelectorAll('.banner-card');
    
    bannerCards.forEach((card, index) => {
      const speed = (index + 1) * 0.05;
      card.style.transform = `translateY(${scrolled * speed}px)`;
    });
  });
  
  // Add entrance animation observer
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -50px 0px'
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.animation = 'cardEntrance 1s ease-out forwards';
      }
    });
  }, observerOptions);
  
  section.querySelectorAll('.banner-card').forEach(card => {
    observer.observe(card);
  });
})();

// Add particle float keyframe
const style = document.createElement('style');
style.textContent = `
  @keyframes particleFloat {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    10% { opacity: 0.8; }
    90% { opacity: 0.8; }
    100% { transform: translateY(-100vh) translateX(50px); opacity: 0; }
  }
  
  @keyframes sparkleEffect {
    0% { transform: scale(0) translate(0, 0); opacity: 1; }
    100% { transform: scale(2) translate(${Math.random() * 40 - 20}px, ${Math.random() * 40 - 20}px); opacity: 0; }
  }
`;
document.head.appendChild(style);
</script>

