{% comment %}
  Shopify Section: Christmas Featured Collection
  File: sections/christmas-featured-collection.liquid
{% endcomment %}

<section class="christmas-collection-section" id="christmas-collection-{{ section.id }}">
  {%- if section.settings.show_snow -%}
  <div class="snow-container" aria-hidden="true">
    {% for i in (1..60) %}
      <div class="snowflake snowflake-{{ i }}"></div>
    {% endfor %}
  </div>
  {%- endif -%}
  
  <div class="container">
    <div class="section-header">
      {%- if section.settings.section_title != blank -%}
        <h2 class="section-title">{{ section.settings.section_title }}</h2>
      {%- endif -%}
      {%- if section.settings.section_subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.section_subtitle }}</p>
      {%- endif -%}
    </div>
    
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
      {%- assign product_limit = section.settings.product_limit -%}
      
      <div class="products-grid">
        {%- for product in collection.products limit: product_limit -%}
          <div class="product-card {% if section.settings.christmas_border %}christmas-border{% endif %}">
            {%- if section.settings.show_gift_ribbon -%}
              <div class="gift-ribbon">🎁 Gift Ready</div>
            {%- endif -%}
            
            <div class="product-image-wrapper">
              {%- if product.featured_image -%}
                <a href="{{ product.url }}" class="product-image-link">
                  <img 
                    src="{{ product.featured_image | img_url: '600x' }}" 
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    class="product-image"
                  >
                  {%- if section.settings.gold_glow -%}
                    <div class="gold-shine"></div>
                  {%- endif -%}
                </a>
              {%- else -%}
                <a href="{{ product.url }}" class="product-image-link">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </a>
              {%- endif -%}
              
              {%- if section.settings.show_sale_badge and product.compare_at_price > product.price -%}
                <div class="sale-badge">{{ section.settings.sale_badge_text }}</div>
              {%- endif -%}
            </div>
            
            <div class="product-info">
              <h3 class="product-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              
              <div class="product-price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="price-sale">{{ product.price | money }}</span>
                  <span class="price-compare">{{ product.compare_at_price | money }}</span>
                {%- else -%}
                  <span class="price-regular">{{ product.price | money }}</span>
                {%- endif -%}
              </div>
              
              <div class="product-actions">
                {%- if product.available -%}
                  <button 
                    type="button" 
                    class="btn-add-cart"
                    onclick="addToCart({{ product.variants.first.id }})"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                      <path d="M9 2L7.17 4H4C2.9 4 2 4.9 2 6V19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V6C22 4.9 21.1 4 20 4H16.83L15 2H9Z" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="12" cy="13" r="3" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                    Add to Cart
                  </button>
                {%- else -%}
                  <button class="btn-add-cart btn-sold-out" disabled>
                    Sold Out
                  </button>
                {%- endif -%}
                <a href="{{ product.url }}" class="btn-view-product">View Details</a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-collection">
        <p>Please select a collection in the section settings.</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
#christmas-collection-{{ section.id }} {
  --color-wine-red: #7b001c;
  --color-gold: #d4af37;
  --color-white-bg: #f9f5ef;
  --color-text-dark: #2d2d2d;
  --color-text-light: #666666;
}

.christmas-collection-section {
  position: relative;
  {% comment %} background: linear-gradient(180deg, var(--color-white-bg) 0%, #ffffff 100%); {% endcomment %}
  padding: 80px 20px;
  overflow: hidden;
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  position: relative;
  z-index: 10;
}

/* Snow Animation */
.snow-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.snowflake {
  position: absolute;
  top: -10px;
  color: rgb(204 236 255);
  animation: snowfall linear infinite;
  user-select: none;
  font-size: 1.2rem;
}

.snowflake::before {
  content: '❄';
}

@keyframes snowfall {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 0;
  }
  10% { opacity: 1; }
  90% { opacity: 0.8; }
  100% {
    transform: translateY(100vh) rotate(360deg);
    opacity: 0;
  }
}

{% for i in (1..60) %}
.snowflake-{{ i }} {
  left: {{ i | times: 1.6 | modulo: 100 }}%;
  animation-delay: {{ i | times: 0.15 | modulo: 8 }}s;
  animation-duration: {{ 12 | plus: i | modulo: 8 }}s;
  font-size: {{ 0.8 | plus: i | modulo: 5 | times: 0.15 }}rem;
}
{% endfor %}

/* Section Header */
.section-header {
  text-align: center;
  margin-bottom: 64px;
  animation: fadeInDown 0.8s ease-out;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 300;
  color: var(--color-wine-red);
  margin: 0 0 16px 0;
  letter-spacing: -0.02em;
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
}

.section-subtitle {
  font-size: clamp(1rem, 2vw, 1.25rem);
  color: var(--color-text-light);
  font-weight: 300;
  margin: 24px 0 0 0;
  line-height: 1.6;
}

/* Products Grid */
.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
  animation: fadeInUp 1s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Product Card */
.product-card {
  background: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(123, 0, 28, 0.08);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.product-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 40px rgba(123, 0, 28, 0.15);
}

.product-card.christmas-border {
  border: 2px solid transparent;
  background-image: 
    linear-gradient(#ffffff, #ffffff),
    linear-gradient(135deg, var(--color-wine-red), var(--color-gold), var(--color-wine-red));
  background-origin: border-box;
  background-clip: padding-box, border-box;
}

/* Gift Ribbon */
.gift-ribbon {
  position: absolute;
  top: 12px;
  right: -32px;
  background: var(--color-gold);
  color: #ffffff;
  padding: 6px 40px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transform: rotate(45deg);
  z-index: 20;
  box-shadow: 0 4px 12px rgba(212, 175, 55, 0.4);
}

/* Product Image */
.product-image-wrapper {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1;
  background: var(--color-white-bg);
}

.product-image-link {
  display: block;
  width: 100%;
  height: 100%;
  position: relative;
}

.product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.product-card:hover .product-image {
  transform: scale(1.08);
}

/* Gold Shine Effect */
.gold-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(212, 175, 55, 0.3) 50%,
    transparent 70%
  );
  opacity: 0;
  transition: opacity 0.6s ease, transform 0.6s ease;
  pointer-events: none;
  z-index: 10;
}

.product-card:hover .gold-shine {
  opacity: 1;
  animation: shine 1.2s ease-in-out;
}

@keyframes shine {
  0% {
    transform: translateX(-100%) translateY(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) translateY(100%) rotate(45deg);
  }
}

/* Sale Badge */
.sale-badge {
  position: absolute;
  top: 16px;
  left: 16px;
  background: var(--color-wine-red);
  color: #ffffff;
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  z-index: 15;
  box-shadow: 0 4px 12px rgba(123, 0, 28, 0.3);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* Product Info */
.product-info {
  padding: 24px;
}

.product-title {
  margin: 0 0 12px 0;
  font-size: 18px;
  font-weight: 500;
  line-height: 1.4;
}

.product-title a {
  color: var(--color-text-dark);
  text-decoration: none;
  transition: color 0.3s ease;
}

.product-title a:hover {
  color: var(--color-wine-red);
}

/* Product Price */
.product-price {
  margin: 0 0 20px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.price-regular,
.price-sale {
  font-size: 20px;
  font-weight: 600;
  color: var(--color-wine-red);
}

.price-compare {
  font-size: 16px;
  color: var(--color-text-light);
  text-decoration: line-through;
}

/* Product Actions */
.product-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.btn-add-cart,
.btn-view-product {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 24px;
  border-radius: 6px;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  text-align: center;
  transition: all 0.3s ease;
  cursor: pointer;
  border: none;
  width: 100%;
}

.btn-add-cart {
  background: var(--color-wine-red);
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(123, 0, 28, 0.2);
}

.btn-add-cart:hover {
  background: #5f0015;
  transform: translateY(-2px);
  box-shadow: 0 6px 24px rgba(212, 175, 55, 0.4);
}

.btn-add-cart svg {
  transition: transform 0.3s ease;
}

.btn-add-cart:hover svg {
  transform: scale(1.1);
}

.btn-sold-out {
  background: #cccccc;
  cursor: not-allowed;
}

.btn-sold-out:hover {
  transform: none;
  box-shadow: 0 4px 16px rgba(123, 0, 28, 0.2);
}

.btn-view-product {
  background: transparent;
  color: var(--color-wine-red);
  border: 1px solid var(--color-wine-red);
}

.btn-view-product:hover {
  background: var(--color-wine-red);
  color: #ffffff;
  transform: translateY(-2px);
}

/* Empty State */
.empty-collection {
  text-align: center;
  padding: 80px 20px;
  color: var(--color-text-light);
  font-size: 18px;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
}

@media (max-width: 900px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  
  .christmas-collection-section {
    padding: 60px 16px;
  }
  
  .section-header {
    margin-bottom: 48px;
  }
}

@media (max-width: 600px) {
  .products-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  
  .christmas-collection-section {
    padding: 48px 16px;
  }
  
  .gift-ribbon {
    font-size: 10px;
    padding: 5px 36px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .snowflake,
  .product-card,
  .sale-badge,
  .gold-shine {
    animation: none;
  }
  
  .product-card:hover {
    transform: none;
  }
}
</style>

<script>
function addToCart(variantId) {
  fetch('/cart/add.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      id: variantId,
      quantity: 1
    })
  })
  .then(response => response.json())
  .then(data => {
    // Trigger cart drawer or redirect to cart
    window.location.href = '/cart';
  })
  .catch(error => {
    console.error('Error:', error);
    alert('There was an error adding the product to cart.');
  });
}
</script>

{% schema %}
{
  "name": "Christmas Collection",
  "tag": "section",
  "class": "section-christmas-collection",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Holiday Gift Collection"
    },
    {
      "type": "textarea",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Curated luxury pieces perfect for gifting this Christmas season"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Visual Effects"
    },
    {
      "type": "checkbox",
      "id": "show_snow",
      "label": "Show Snow Animation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "christmas_border",
      "label": "Christmas Border Style",
      "default": true,
      "info": "Adds decorative gold/wine gradient border"
    },
    {
      "type": "checkbox",
      "id": "gold_glow",
      "label": "Gold Glow Effect",
      "default": true,
      "info": "Shows gold shine on hover"
    },
    {
      "type": "header",
      "content": "Badges & Features"
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show Sale Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "Sale Badge Text",
      "default": "Sale"
    },
    {
      "type": "checkbox",
      "id": "show_gift_ribbon",
      "label": "Show Gift Ready Ribbon",
      "default": true,
      "info": "Displays '🎁 Gift Ready' ribbon on products"
    }
  ],
  "presets": [
    {
      "name": "Christmas Collection",
      "settings": {
        "section_title": "Holiday Gift Collection",
        "section_subtitle": "Curated luxury pieces perfect for gifting this Christmas season",
        "product_limit": 8,
        "show_snow": true,
        "christmas_border": true,
        "gold_glow": true,
        "show_sale_badge": true,
        "sale_badge_text": "Sale",
        "show_gift_ribbon": true
      }
    }
  ]
}
{% endschema %}