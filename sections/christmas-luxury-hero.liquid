{% comment %}
  Shopify Section: Christmas Luxury Hero
  File: sections/christmas-luxury-hero.liquid
{% endcomment %}

<section class="christmas-luxury-section" id="christmas-hero-{{ section.id }}">
  <div class="snow-container" aria-hidden="true">
    {% for i in (1..50) %}
      <div class="snowflake snowflake-{{ i }}"></div>
    {% endfor %}
  </div>
  
  <div class="container">
    <div class="hero-content">
      {% if section.settings.show_badge %}
        <div class="luxury-badge">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="sparkle-icon">
            <path d="M12 2L13.09 8.26L19 10L13.09 11.74L12 18L10.91 11.74L5 10L10.91 8.26L12 2Z" fill="currentColor"/>
            <path d="M19 14L19.5 16.5L22 17L19.5 17.5L19 20L18.5 17.5L16 17L18.5 16.5L19 14Z" fill="currentColor"/>
          </svg>
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h1 class="hero-title">
          <span class="title-line">{{ section.settings.heading }}</span>
          {% if section.settings.heading_highlight != blank %}
            <span class="title-line highlight">{{ section.settings.heading_highlight }}</span>
          {% endif %}
        </h1>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <div class="hero-description">
          {{ section.settings.description }}
        </div>
      {% endif %}
      
      <div class="hero-cta">
        {% if section.settings.button_label_1 != blank %}
          <a href="{{ section.settings.button_link_1 }}" class="btn btn-primary">
            {{ section.settings.button_label_1 }}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
        
        {% if section.settings.button_label_2 != blank %}
          <a href="{{ section.settings.button_link_2 }}" class="btn btn-secondary">
            {{ section.settings.button_label_2 }}
          </a>
        {% endif %}
      </div>
      
      {% if section.settings.show_features %}
        <div class="hero-features">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div class="feature-item" {{ block.shopify_attributes }}>
                {% if block.settings.icon == 'certified' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                {% elsif block.settings.icon == 'shipping' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 12L11 15L16 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                {% elsif block.settings.icon == 'packaging' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="8" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M7 8V6C7 3.79086 8.79086 2 11 2H13C15.2091 2 17 3.79086 17 6V8" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                {% endif %}
                <span>{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
  
  <div class="hero-ornament ornament-1" aria-hidden="true">
    <div class="ornament-inner"></div>
  </div>
  <div class="hero-ornament ornament-2" aria-hidden="true">
    <div class="ornament-inner"></div>
  </div>
</section>

<style>
#christmas-hero-{{ section.id }} {
  --color-primary: {{ section.settings.color_primary }};
  --color-secondary: {{ section.settings.color_secondary }};
  --color-accent: {{ section.settings.color_accent }};
  --color-background: {{ section.settings.color_background }};
  --section-padding: {{ section.settings.section_padding }}px;
}

.christmas-luxury-section {
  position: relative;
  min-height: {{ section.settings.section_height }}vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-background) 0%, #ffffff 50%, var(--color-background) 100%);
  overflow: hidden;
  padding: var(--section-padding) 20px;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  position: relative;
  z-index: 10;
}

.snow-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.snowflake {
  position: absolute;
  top: -10px;
  color: rgb(204 236 255);
  animation: snowfall linear infinite;
  user-select: none;
}

.snowflake::before {
  content: '❄';
  font-size: 1rem;
}

@keyframes snowfall {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 0;
  }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% {
    transform: translateY(100vh) rotate(360deg);
    opacity: 0;
  }
}

{% for i in (1..50) %}
.snowflake-{{ i }} {
  left: {{ i | times: 2 | modulo: 100 }}%;
  animation-delay: {{ i | times: 0.2 | modulo: 10 }}s;
  animation-duration: {{ 15 | plus: i | modulo: 10 }}s;
}
{% endfor %}

.hero-content {
  text-align: center;
  max-width: 900px;
  margin: 0 auto;
  animation: fadeInUp 1s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.luxury-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 24px;
  background: #ffffff;
  border: 1px solid rgba(139, 115, 85, 0.2);
  border-radius: 50px;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--color-secondary);
  margin-bottom: 32px;
  box-shadow: 0 4px 20px rgba(139, 115, 85, 0.1);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

.sparkle-icon {
  color: var(--color-accent);
  animation: sparkle 2s ease-in-out infinite;
}

@keyframes sparkle {
  0%, 100% { opacity: 1; transform: scale(1) rotate(0deg); }
  50% { opacity: 0.7; transform: scale(1.1) rotate(180deg); }
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 300;
  line-height: 1.2;
  margin: 32px 0;
  color: var(--color-primary);
  letter-spacing: -0.02em;
}

.title-line {
  display: block;
}

.title-line.highlight {
  font-weight: 400;
  background: linear-gradient(135deg, var(--color-secondary), var(--color-accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 3s ease-in-out infinite;
  background-size: 200% 200%;
}

@keyframes shimmer {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.hero-description {
  font-size: clamp(1rem, 2vw, 1.25rem);
  line-height: 1.6;
  color: #6b6b6b;
  margin: 32px auto;
  max-width: 600px;
  font-weight: 300;
}

.hero-cta {
  display: flex;
  gap: 16px;
  justify-content: center;
  align-items: center;
  margin: 64px 0;
  flex-wrap: wrap;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 16px 32px;
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s ease;
  border: 1px solid transparent;
  cursor: pointer;
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 4px 20px rgba(26, 26, 26, 0.2);
}

.btn-primary:hover {
  background: var(--color-secondary);
  transform: translateY(-2px);
  box-shadow: 0 6px 30px rgba(139, 115, 85, 0.3);
}

.btn-primary svg {
  transition: transform 0.3s ease;
}

.btn-primary:hover svg {
  transform: translateX(4px);
}

.btn-secondary {
  background: transparent;
  color: var(--color-primary);
  border-color: var(--color-primary);
}

.btn-secondary:hover {
  background: var(--color-primary);
  color: #ffffff;
  transform: translateY(-2px);
}

.hero-features {
  display: flex;
  justify-content: center;
  gap: 64px;
  margin-top: 96px;
  flex-wrap: wrap;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: #6b6b6b;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.5px;
}

.feature-item svg {
  color: var(--color-accent);
  transition: transform 0.3s ease;
}

.feature-item:hover svg {
  transform: scale(1.1);
}

.hero-ornament {
  position: absolute;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  opacity: 0.15;
  animation: rotate 20s linear infinite;
}

.ornament-1 {
  top: 10%;
  left: 5%;
}

.ornament-2 {
  bottom: 15%;
  right: 8%;
  animation-direction: reverse;
  animation-duration: 25s;
}

.ornament-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, var(--color-accent), var(--color-secondary));
  position: relative;
}

.ornament-inner::before {
  content: '';
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 20px;
  background: var(--color-secondary);
  border-radius: 4px;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@media (max-width: 768px) {
  .christmas-luxury-section {
    min-height: 80vh;
    padding: 64px 16px;
  }
  
  .hero-cta {
    flex-direction: column;
  }
  
  .btn {
    width: 100%;
    justify-content: center;
  }
  
  .hero-features {
    gap: 32px;
  }
  
  .hero-ornament {
    width: 80px;
    height: 80px;
  }
}

@media (max-width: 480px) {
  .hero-features {
    flex-direction: column;
    gap: 16px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .snowflake,
  .luxury-badge,
  .sparkle-icon,
  .hero-ornament,
  .title-line.highlight {
    animation: none;
  }
}
</style>

