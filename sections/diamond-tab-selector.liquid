{% stylesheet %}
.diamond-tabs-wrapper {
  margin: 40px auto;
  padding: 20px;
  max-width: 1200px;
}

.diamond-tabs-heading {
  text-align: center;
  margin-bottom: 30px;
}
.diamond-tabs-heading h2 {
  font-size: 28px;
  margin: 0;
}
.diamond-tabs-heading p {
  color: #777;
  margin-top: 5px;
}

.diamond-tabs-container {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  justify-content: center;
  margin-bottom: 30px;
}

.diamond-tab {
  cursor: pointer;
  text-align: center;
  /* border: 1px solid #ccc; */
  padding: 10px;
  border-radius: 8px;
  transition: all 0.3s;
  width: 100px;
}
/* .diamond-tab.active {
  border-color: #000;
  background-color: #ffffff;
} */
.diamond-tab img {
    max-height: 60px;
    margin-bottom: 8px;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* opacity: 0.5; */
}
.diamond-tab-content {
  display: none;
}
.diamond-tab-content.active {
  display: block;
}

/* Table Styling */
.diamond-tab-content table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 15px;
}
.diamond-tab-content table,
.diamond-tab-content th,
.diamond-tab-content td {
  border: 1px solid #ccc;
}
.diamond-tab-content th,
.diamond-tab-content td {
  padding: 8px 12px;
  text-align: center;
  color: #000;
}
.diamond-tab-content img {
  max-width: 100%;
  margin-top: 15px;
}
.title-tab-sec {
    font-size: 12px;
    line-height: 14px;
    font-weight: 600;
    text-transform: capitalize;
}
h3.sub-title-diamond {
    text-transform: capitalize;
}
/* .diamond-tab:hover {
    background-color: #ffffff;
    border: 1px solid #000;
} */
#dimoandtab{
  max-width: 48%;
}
/* section#shopify-section-template--24914850218279__main .page-width.section-template--24914850218279__main-padding {
    width: 50%;
    margin: 0 auto;
    text-align: center;
} */
@media (max-width: 575px) {
  #dimoandtab{
    max-width: 100%;
  }
  .diamond-tab {
    width: 68px;
  }
  .diamond-tabs-container {
    gap: 6px;
    margin-bottom: 27px;
  }
  .diamond-tabs-wrapper {
    margin: 10px 0;
    padding: 15px;
  }
}
{% endstylesheet %}

<div class="diamond-tabs-wrapper">
  {% if section.settings.section_title != blank or section.settings.section_subtitle != blank %}
    <div class="diamond-tabs-heading">
      {% if section.settings.section_title != blank %}
        <h2>{{ section.settings.section_title }}</h2>
      {% endif %}
      {% if section.settings.section_subtitle != blank %}
        <p>{{ section.settings.section_subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="diamond-tabs-container">
    {% for block in section.blocks %}
      <div class="diamond-tab" data-tab-id="tab-{{ block.id }}">
        <img src="{{ block.settings.tab_image | image_url: width: 100 }}" alt="{{ block.settings.shape_name }}">
        <div class="title-tab-sec">{{ block.settings.shape_name }}</div>
      </div>
    {% endfor %}
  </div>

  <div class="diamond-tab-contents">
    {% for block in section.blocks %}
      <div class="diamond-tab-content" id="tab-{{ block.id }}">
        <h3 class="sub-title-diamond">{{ block.settings.shape_name }}</h3>
        <div>{{ block.settings.shape_description | raw }}</div>
      </div>
    {% endfor %}
  </div>
</div>

{% javascript %}
document.addEventListener("DOMContentLoaded", function () {
  const tabs = document.querySelectorAll(".diamond-tab");
  const contents = document.querySelectorAll(".diamond-tab-content");

  function deactivateAll() {
    tabs.forEach(tab => tab.classList.remove("active"));
    contents.forEach(content => content.classList.remove("active"));
  }

  tabs.forEach(tab => {
    tab.addEventListener("click", function () {
      const targetId = tab.getAttribute("data-tab-id");
      deactivateAll();
      tab.classList.add("active");
      document.getElementById(targetId).classList.add("active");
    });
  });

  // Activate first tab by default
  if (tabs.length) {
    tabs[0].click();
  }
});

{% endjavascript %}

{% schema %}
{
  "name": "Diamond Tabs",
  "tag": "section",
  "class": "diamond-tabs-section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Explore Diamond Shapes"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Choose your favorite diamond cut"
    }
  ],
  "max_blocks": 30,
  "blocks": [
    {
      "type": "tab",
      "name": "Diamond Tab",
      "settings": [
        {
          "type": "image_picker",
          "id": "tab_image",
          "label": "Diamond Shape Image"
        },
        {
          "type": "text",
          "id": "shape_name",
          "label": "Shape Name",
          "default": "Round"
        },
        {
          "type": "textarea",
          "id": "shape_description",
          "label": "Shape Description",
          "default": "<p>The round brilliant diamond is the most popular shape.</p>\\n\\n<table>\\n  <tr><th>MM Size</th><th>Carat Weight</th></tr>\\n  <tr><td>6.5 mm</td><td>1.00 ct</td></tr>\\n  <tr><td>7.0 mm</td><td>1.25 ct</td></tr>\\n</table>\\n\\n<p><img src=\\\"https://cdn.shopify.com/s/files/1/example.jpg\\\" alt=\\\"Diamond chart\\\"></p>\\n\\n<p><a href=\\\"/pages/diamond-guide\\\" target=\\\"_blank\\\">View Full Diamond Guide</a></p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Diamond Tab Selector",
      "category": "Custom"
    }
  ]
}
{% endschema %}
