{% comment %}
  🎃 Halloween Banner Section
  Fully editable, responsive, and easy to add/remove.
{% endcomment %}

<section id="halloween-banner" class="halloween-banner-section">
  <div class="halloween-banner-wrapper">
    {% if section.settings.background_image != blank %}
      <img class="banner-bg" src="{{ section.settings.background_image | img_url: 'master' }}" alt="Halloween Banner Background" loading="lazy">
    {% endif %}

    {% if section.settings.moon_image != blank %}
      <img class="banner-moon" src="{{ section.settings.moon_image | img_url: 'master' }}" alt="Moon" loading="lazy">
    {% endif %}

    {% if section.settings.cross_image != blank %}
      <img class="banner-cross" src="{{ section.settings.cross_image | img_url: 'master' }}" alt="Cross on Tree" loading="lazy">
    {% endif %}

    <div class="halloween-content">
      {% if section.settings.heading != blank %}
        <h1 class="banner-heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="banner-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="banner-button">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>

  <style>
    /* ===== Halloween Banner Styles ===== */
    .halloween-banner-section {
      position: relative;
      width: 100%;
      overflow: hidden;
      display: block;
      background-color: #000;
    }

    .halloween-banner-wrapper {
      position: relative;
      width: 100%;
      height: 100%;
      text-align: center;
      color: #fff;
    }

    .halloween-banner-wrapper .banner-bg {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    .banner-moon {
        position: absolute;
        top: 10%;
        right: 8%;
        width: 250px;
        opacity: 1;
        animation: topToBottom 10s linear infinite;
    }

    .banner-cross {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        transform: rotate(-5deg);
        animation: fadeinout 4s infinite;
    }

    .halloween-content {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
    }

    .banner-heading {
      font-size: 3rem;
      color: #ff6600;
      text-shadow: 2px 2px 8px #000;
      margin-bottom: 0.5rem;
    }

    .banner-subheading {
      font-size: 1.2rem;
      color: #fff;
      margin-bottom: 1rem;
    }

    .banner-button {
      display: inline-block;
      background-color: #ff6600;
      color: #fff;
      padding: 10px 25px;
      border-radius: 30px;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: 0.3s;
      text-decoration: none;
    }

    .banner-button:hover {
      background-color: #ff8533;
      transform: scale(1.05);
    }

    @keyframes floatMoon {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    @keyframes topToBottom {
        0% {
            transform: translateY(-100%); /* start above */
            opacity: 0;
        }
        10% {
            opacity: 1; /* fade in */
        }
        50% {
            transform: translateY(10vh); /* move down */
            opacity: 1;
        }
        90% {
            opacity: 1; /* still visible */
        }
        100% {
            transform: translateY(-100%); /* back up */
            opacity: 0;
        }
    }
    @keyframes fadeinout
      {
        0%{
          opacity:0;
        }
        50%
        {
          opacity:1;
        }
        100%
        {
          opacity:0;
        }
      }
    @keyframes slightMove {
      0%, 100% { transform: translateY(0) rotate(-5deg); }
      50% { transform: translateY(-5px) rotate(-3deg); }
    }

    @media (max-width: 768px) {
      .banner-heading { font-size: 2rem; }
      .banner-subheading { font-size: 1rem; }
      .banner-cross { width: 80px; left: 10%; }
      .banner-moon { width: 70px; right: 10%; }
    }
  </style>
</section>

{% schema %}
{
  "name": "🎃 Halloween Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "moon_image",
      "label": "Moon Image"
    },
    {
      "type": "image_picker",
      "id": "cross_image",
      "label": "Cross Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Halloween Sale"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Spooky discounts await you..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "🎃 Halloween Banner",
      "category": "Banners"
    }
  ]
}
{% endschema %}
