{% doc %}
  @prompt
    Welcome to The Minimal Carbon. Your destination for sustainable, minimalist fine jewelry that blends timeless design with thoughtful craftsmanship. We began as a highly rated shop on global marketplaces like Etsy, eBay, and Amazon and have now launched our own platform to connect directly with you — our valued customers — without any third-party barriers. 
    
    At The Minimal Carbon, we curate unique diamonds and jewelry pieces with a focus on quality, creativity, and affordability. Our collections include natural diamonds, handcrafted minimalist jewelry, and lab-grown diamonds and gemstones — all selected to suit both personal and professional needs. 
    
    I want to show only this text, so please create a dedicated section for it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-welcome-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-welcome-text__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-welcome-text__content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
  }

  .ai-welcome-text__content-{{ ai_gen_id }} p {
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
  }

  .ai-welcome-text__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-welcome-text-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-welcome-text__content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-welcome-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-welcome-text__container-{{ ai_gen_id }}">
    <div class="ai-welcome-text__content-{{ ai_gen_id }}">
      {{ block.settings.welcome_text }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Welcome text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "welcome_text",
      "label": "Text",
      "default": "<p>Welcome to The Minimal Carbon. Your destination for sustainable, minimalist fine jewelry that blends timeless design with thoughtful craftsmanship. We began as a highly rated shop on global marketplaces like Etsy, eBay, and Amazon and have now launched our own platform to connect directly with you — our valued customers — without any third-party barriers.</p><p>At The Minimal Carbon, we curate unique diamonds and jewelry pieces with a focus on quality, creativity, and affordability. Our collections include natural diamonds, handcrafted minimalist jewelry, and lab-grown diamonds and gemstones — all selected to suit both personal and professional needs.</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Font",
      "default": "lato_n4"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Desktop font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "line_height",
