{% doc %}
  @prompt
    Section 4: Featured Products (From Selected Collection)
    Purpose
    
    Showcase best-selling or Valentine-specific products directly on homepage.
    
    Layout
    
    Product grid
    
    4 products per row (desktop)
    
    Responsive for tablet & mobile
    
    Functionality
    
    Admin selects one collection
    
    Products auto-load from that collection
    
    Product cards include:
    
    Product image
    
    Title
    
    Price
    
    Quick add / view option
    
    Background Design
    
    Soft Valentine-themed background:
    
    Faded hearts
    
    Light pink / blush gradient
    
    Very subtle (to keep focus on products)
    
    Shopify Settings (Editable)
    
    Collection selector
    
    Products per row
    
    Background image upload
    
    Background color
    
    Section padding
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-products-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    overflow: hidden;
    width: 100%;
  }

  .ai-featured-products-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background: {{ block.settings.background_color }};
  }

  .ai-featured-products-background-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
    background-size: cover;
    background-position: center;
    opacity: {{ block.settings.background_image_opacity }};
    z-index: 1;
  }

  .ai-featured-products-background-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(255, 182, 193, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(255, 192, 203, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(255, 105, 180, 0.08) 0%, transparent 60%);
    z-index: 2;
    pointer-events: none;
  }

  .ai-featured-products-hearts-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    opacity: {{ block.settings.hearts_opacity }};
    pointer-events: none;
  }

  .ai-featured-products-heart-{{ ai_gen_id }} {
    position: absolute;
    color: {{ block.settings.hearts_color }};
    font-size: 40px;
    opacity: 0.3;
  }

  .ai-featured-products-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 4;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-products-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-featured-products-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-featured-products-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-featured-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: 20px;
  }

  .ai-featured-product-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .ai-featured-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }

  .ai-featured-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 125%;
    overflow: hidden;
    background: #f5f5f5;
  }

  .ai-featured-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-featured-product-card-{{ ai_gen_id }}:hover .ai-featured-product-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-featured-product-info-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-featured-product-title-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-featured-product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-featured-product-title-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.title_color }};
  }

  .ai-featured-product-price-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.product_price_color }};
    margin: 0 0 15px;
    font-weight: 600;
  }

  .ai-featured-product-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
    font-size: 16px;
  }

  .ai-featured-product-actions-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
  }

  .ai-featured-product-button-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px 20px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .ai-featured-product-button-primary-{{ ai_gen_id }} {
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-featured-product-button-primary-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-featured-product-button-secondary-{{ ai_gen_id }} {
    background: transparent;
    color: {{ block.settings.button_background }};
    border: 1px solid {{ block.settings.button_background }};
  }

  .ai-featured-product-button-secondary-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-featured-products-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #868686;
  }

  @media screen and (max-width: 989px) {
    .ai-featured-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-featured-products-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(1, 1fr);
    }

    .ai-featured-products-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }
  }
{% endstyle %}

<div class="ai-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-products-background-{{ ai_gen_id }}"></div>
  
  {% if block.settings.show_hearts %}
    <div class="ai-featured-products-hearts-{{ ai_gen_id }}">
      <span class="ai-featured-products-heart-{{ ai_gen_id }}" style="top: 10%; left: 5%;">♥</span>
      <span class="ai-featured-products-heart-{{ ai_gen_id }}" style="top: 20%; left: 85%;">♥</span>
      <span class="ai-featured-products-heart-{{ ai_gen_id }}" style="top: 60%; left: 10%;">♥</span>
      <span class="ai-featured-products-heart-{{ ai_gen_id }}" style="top: 75%; left: 90%;">♥</span>
      <span class="ai-featured-products-heart-{{ ai_gen_id }}" style="top: 40%; left: 50%;">♥</span>
      <span class="ai-featured-products-heart-{{ ai_gen_id }}" style="top: 85%; left: 25%;">♥</span>
      <span class="ai-featured-products-heart-{{ ai_gen_id }}" style="top: 15%; left: 70%;">♥</span>
      <span class="ai-featured-products-heart-{{ ai_gen_id }}" style="top: 50%; left: 15%;">♥</span>
    </div>
  {% endif %}

  <div class="ai-featured-products-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-featured-products-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-featured-products-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-featured-products-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      <div class="ai-featured-products-grid-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_limit %}
          <div class="ai-featured-product-card-{{ ai_gen_id }}">
            <div class="ai-featured-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-featured-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="750"
                >
              {% else %}
                <div class="ai-featured-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-featured-product-info-{{ ai_gen_id }}">
              <h3 class="ai-featured-product-title-{{ ai_gen_id }}">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <div class="ai-featured-product-price-{{ ai_gen_id }}">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="ai-featured-product-price-compare-{{ ai_gen_id }}">
                    {{ product.compare_at_price | money }}
                  </span>
                {% endif %}
              </div>

              <div class="ai-featured-product-actions-{{ ai_gen_id }}">
                {% if block.settings.show_quick_add %}
                  <button
                    type="button"
                    class="ai-featured-product-button-{{ ai_gen_id }} ai-featured-product-button-primary-{{ ai_gen_id }}"
                    onclick="window.location.href='{{ product.url }}'"
                  >
                    {{ block.settings.quick_add_text }}
                  </button>
                {% endif %}
                
                {% if block.settings.show_view_product %}
                  <a
                    href="{{ product.url }}"
                    class="ai-featured-product-button-{{ ai_gen_id }} ai-featured-product-button-secondary-{{ ai_gen_id }}"
                  >
                    {{ block.settings.view_product_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-featured-products-empty-{{ ai_gen_id }}">
        <p>Please select a collection to display products</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Valentine's Day Collection"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover our handpicked selection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 20,
      "step": 4,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "label": "Grid gap",
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Top padding",
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Bottom padding",
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFF5F7"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Background image opacity",
      "default": 0.1
    },
    {
      "type": "checkbox",
      "id": "show_hearts",
      "label": "Show decorative hearts",
      "default": true
    },
    {
      "type": "color",
      "id": "hearts_color",
      "label": "Hearts color",
      "default": "#FFB6C1"
    },
    {
      "type": "range",
      "id": "hearts_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Hearts opacity",
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 36
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#CB8161"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 16
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#868686"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 12
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Product price color",
      "default": "#CB8161"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "quick_add_text",
      "label": "Quick add text",
      "default": "Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "show_view_product",
      "label": "Show view product button",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "view_product_text",
      "label": "View product text",
      "default": "View"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#CB8161"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#A0A0A0"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
