                </div>
              {% endif %}
              {% if block.settings.show_mastercard %}
                <div class="ai-footer-payment-icon-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 32"><circle fill="#EB001B" cx="18" cy="16" r="10"/><circle fill="#F79E1B" cx="30" cy="16" r="10"/><path fill="#FF5F00" d="M24 8.9c-2.3 1.8-3.8 4.6-3.8 7.8s1.5 6 3.8 7.8c2.3-1.8 3.8-4.6 3.8-7.8s-1.5-6-3.8-7.8z"/></svg>
                </div>
              {% endif %}
              {% if block.settings.show_amex %}
                <div class="ai-footer-payment-icon-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 32"><path fill="#006FCF" d="M0 0h48v32H0z"/><path fill="#FFF" d="M6.4 12.1h2.6l-.7 1.7h2.2l.7-1.7h2.6l-3.5 7.8H8.1l.8-1.8H6.7l-.8 1.8H3.7l3.5-7.8h-.8zm29.8 0l-1.5 3.6-1.5-3.6h-3.1l3 7.8h2.3l3-7.8h-2.2zm-11.7 0h-2.4l-3.5 7.8h2.4l.6-1.4h3.4l.6 1.4h2.6l-3.7-7.8zm-1.2 2.1l1 2.4h-2l1-2.4zm-8.8-.3h2.8c.8 0 1.4.6 1.4 1.4 0 .8-.6 1.4-1.4 1.4h-2.8v-2.8zm0 4.7h2.8l1.8 1.4h2.9l-2.1-1.6c1-.3 1.7-1.2 1.7-2.3 0-1.4-1.1-2.5-2.5-2.5h-5.2v7.8h2.6v-3.8h-.1z"/></svg>
                </div>
              {% endif %}
