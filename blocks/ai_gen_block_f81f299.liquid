{% doc %}
  @prompt
    📩 7. Footer Section Prompt
    
    Create a dark footer similar to Ouros Jewels.
    Background: deep navy or black (#0b0b1a).
    Columns (4–5):
    
    About Us
    
    Collections
    
    Education
    
    Policies
    
    Subscribe Newsletter
    Include email input with “Sign Up” button.
    Add social media icons (Facebook, Instagram, YouTube, LinkedIn, TikTok).
    Add payment icons (Visa, MasterCard, Amex, PayPal, ShopPay).
    Font: white, accent: gold for headings.
    Bottom copyright line: “© 2025 [Your Brand Name]. All Rights Reserved.”
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: 60px 20px 20px;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-footer-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-bottom: 40px;
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-footer-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-footer-links-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-footer-links-{{ ai_gen_id }} li {
    margin-bottom: 12px;
  }

  .ai-footer-links-{{ ai_gen_id }} a {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s ease;
  }

  .ai-footer-links-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-newsletter-{{ ai_gen_id }} {
    margin-top: 10px;
  }

  .ai-footer-newsletter-form-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    margin-top: 15px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: {{ block.settings.text_color }};
    border-radius: 4px;
    font-size: 14px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }}::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-footer-social-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
    margin-top: 20px;
  }

  .ai-footer-social-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: {{ block.settings.text_color }};
    transition: all 0.3s ease;
  }

  .ai-footer-social-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.heading_color }};
    transform: translateY(-3px);
  }

  .ai-footer-social-link-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .ai-footer-payment-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }} {
    width: 50px;
    height: 32px;
    background-color: #ffffff;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }} svg {
    max-width: 100%;
    max-height: 100%;
  }

  .ai-footer-bottom-{{ ai_gen_id }} {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 30px;
    text-align: center;
  }

  .ai-footer-copyright-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    margin: 0;
  }

  .ai-footer-newsletter-success-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin-top: 10px;
    font-size: 14px;
  }

  .ai-footer-newsletter-error-{{ ai_gen_id }} {
    color: #ff6b6b;
    margin-top: 10px;
    font-size: 14px;
  }

  @media screen and (max-width: 768px) {
    .ai-footer-main-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-footer-newsletter-form-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-footer-social-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-footer-payment-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-main-{{ ai_gen_id }}">
      {% if block.settings.show_about %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.about_heading }}</h3>
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.about_link_1_text != blank %}
              <li><a href="{{ block.settings.about_link_1_url }}">{{ block.settings.about_link_1_text }}</a></li>
            {% endif %}
            {% if block.settings.about_link_2_text != blank %}
              <li><a href="{{ block.settings.about_link_2_url }}">{{ block.settings.about_link_2_text }}</a></li>
            {% endif %}
            {% if block.settings.about_link_3_text != blank %}
              <li><a href="{{ block.settings.about_link_3_url }}">{{ block.settings.about_link_3_text }}</a></li>
            {% endif %}
            {% if block.settings.about_link_4_text != blank %}
              <li><a href="{{ block.settings.about_link_4_url }}">{{ block.settings.about_link_4_text }}</a></li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_collections %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.collections_heading }}</h3>
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.collections_link_1_text != blank %}
              <li><a href="{{ block.settings.collections_link_1_url }}">{{ block.settings.collections_link_1_text }}</a></li>
            {% endif %}
            {% if block.settings.collections_link_2_text != blank %}
              <li><a href="{{ block.settings.collections_link_2_url }}">{{ block.settings.collections_link_2_text }}</a></li>
            {% endif %}
            {% if block.settings.collections_link_3_text != blank %}
              <li><a href="{{ block.settings.collections_link_3_url }}">{{ block.settings.collections_link_3_text }}</a></li>
            {% endif %}
            {% if block.settings.collections_link_4_text != blank %}
              <li><a href="{{ block.settings.collections_link_4_url }}">{{ block.settings.collections_link_4_text }}</a></li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_education %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.education_heading }}</h3>
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.education_link_1_text != blank %}
              <li><a href="{{ block.settings.education_link_1_url }}">{{ block.settings.education_link_1_text }}</a></li>
            {% endif %}
            {% if block.settings.education_link_2_text != blank %}
              <li><a href="{{ block.settings.education_link_2_url }}">{{ block.settings.education_link_2_text }}</a></li>
            {% endif %}
            {% if block.settings.education_link_3_text != blank %}
              <li><a href="{{ block.settings.education_link_3_url }}">{{ block.settings.education_link_3_text }}</a></li>
            {% endif %}
            {% if block.settings.education_link_4_text != blank %}
              <li><a href="{{ block.settings.education_link_4_url }}">{{ block.settings.education_link_4_text }}</a></li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_policies %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.policies_heading }}</h3>
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.policies_link_1_text != blank %}
              <li><a href="{{ block.settings.policies_link_1_url }}">{{ block.settings.policies_link_1_text }}</a></li>
            {% endif %}
            {% if block.settings.policies_link_2_text != blank %}
              <li><a href="{{ block.settings.policies_link_2_url }}">{{ block.settings.policies_link_2_text }}</a></li>
            {% endif %}
            {% if block.settings.policies_link_3_text != blank %}
              <li><a href="{{ block.settings.policies_link_3_url }}">{{ block.settings.policies_link_3_text }}</a></li>
            {% endif %}
            {% if block.settings.policies_link_4_text != blank %}
              <li><a href="{{ block.settings.policies_link_4_url }}">{{ block.settings.policies_link_4_text }}</a></li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_newsletter %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.newsletter_heading }}</h3>
          <div class="ai-footer-newsletter-{{ ai_gen_id }}">
            {% form ai_gen_id %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input
                type="email"
                name="contact[email]"
                class="ai-footer-newsletter-input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.newsletter_placeholder }}"
                aria-label="Email address"
                required
              >
              <button type="submit" class="ai-footer-newsletter-button-{{ ai_gen_id }}">
                {{ block.settings.newsletter_button_text }}
              </button>
            {% endform %}
            {% if form.posted_successfully? %}
              <div class="ai-footer-newsletter-success-{{ ai_gen_id }}">
                {{ block.settings.newsletter_success_message }}
              </div>
            {% endif %}
            {% if form.errors %}
              <div class="ai-footer-newsletter-error-{{ ai_gen_id }}">
                {{ form.errors.messages.email }}
              </div>
            {% endif %}
          </div>

          {% if block.settings.show_social %}
            <div class="ai-footer-social-{{ ai_gen_id }}">
              {% if block.settings.facebook_url != blank %}
                <a href="{{ block.settings.facebook_url }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
              {% endif %}
              {% if block.settings.instagram_url != blank %}
                <a href="{{ block.settings.instagram_url }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
              {% endif %}
              {% if block.settings.youtube_url != blank %}
                <a href="{{ block.settings.youtube_url }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="YouTube">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </a>
              {% endif %}
              {% if block.settings.linkedin_url != blank %}
                <a href="{{ block.settings.linkedin_url }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="LinkedIn">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
              {% endif %}
              {% if block.settings.tiktok_url != blank %}
                <a href="{{ block.settings.tiktok_url }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="TikTok">
