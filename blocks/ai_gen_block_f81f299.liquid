                </a>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.show_payment %}
            <div class="ai-footer-payment-{{ ai_gen_id }}">
              {% if block.settings.show_visa %}
                <div class="ai-footer-payment-icon-{{ ai_gen_id }}">
