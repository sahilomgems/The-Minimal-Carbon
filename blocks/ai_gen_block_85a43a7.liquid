{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px 0;
    overflow: hidden;
    position: relative;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-marquee-content-{{ ai_gen_id }} {
    display: flex;
    white-space: nowrap;
    padding-right: 50px;
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: 1px;
    transition: text-shadow 0.3s ease;
  }

  .ai-marquee-{{ ai_gen_id }}:hover .ai-marquee-item-{{ ai_gen_id }} {
    text-shadow: 0 0 10px {{ block.settings.glow_color }},
                 0 0 20px {{ block.settings.glow_color }},
                 0 0 30px {{ block.settings.glow_color }};
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.875 }}px;
    }
  }
{% endstyle %}

<div class="ai-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-track-{{ ai_gen_id }}">
    <div class="ai-marquee-content-{{ ai_gen_id }}">
      <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.marquee_text }}</span>
    </div>
    <div class="ai-marquee-content-{{ ai_gen_id }}" aria-hidden="true">
      <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.marquee_text }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling marquee",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "Black Friday Sale 🔥 | Old Cut Collection Sale 💎 | Customize Stud Offer ✨ | Ready To Ship Deals 🛍"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#d4af37"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow",
      "default": "#d4af37"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 15
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "label": "Scroll speed",
      "default": 30,
      "info": "Lower number = faster scroll"
    }
  ],
  "presets": [
    {
      "name": "Scrolling marquee"
    }
  ]
}
{% endschema %}
