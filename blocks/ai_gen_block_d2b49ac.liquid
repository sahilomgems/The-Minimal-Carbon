      "default": "#ff6b9d"
    },
    {
      "type": "header",
      "content": "Stars style"
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Star size",
