      "unit": "px",
      "label": "Icon size",
      "default": 100
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Icon bottom spacing",
      "default": 20
    },
    {
      "type": "color",
      "id": "heart_color",
