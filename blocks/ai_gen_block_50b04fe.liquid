{% doc %}
  @prompt
    Prompt:
    
    Create a Shopify custom section in Liquid, HTML, CSS, and JavaScript named “Black Friday Best Selling Categories”.
    
    The section must:
    
    Theme: Luxury jewelry / Black Friday style — use black and gold colors with subtle gradient tones (#000000 background and #d4af37 gold highlights).
    
    Heading: “Best Selling Items” centered in bold, elegant font (Playfair Display or serif).
    
    Category Cards:
    
    Display 5–6 category cards (Engagement Rings, Wedding Bands, Earrings, Necklaces, Bracelets).
    
    Each card must include an image, title text, and link to a collection (e.g., /collections/best-selling?select_by_product=Engagement+Rings).
    
    The image should fill its container with a square aspect ratio and a light shadow effect.
    
    Responsive Design:
    
    Desktop: show 6 cards in one row (grid).
    
    Tablet: slider view with 3 cards visible and swipe enabled.
    
    Mobile: slider view with 2 cards visible.
    
    Scroll Controls:
    
    Left and right arrow buttons for tablet and mobile.
    
    Pagination text (e.g., “1/2”) that updates when scrolling.
    
    Button: A gold “VIEW ALL” button under the grid that links to /collections/best-selling.
    
    Animations:
    
    Fade-up animation when the section appears on desktop.
    
    Smooth scroll transitions on tablet/mobile.
    
    AI Editor Fields (for Shopify schema):
    
    Editable heading text
    
    Add/remove categories (each with image, title, and link)
    
    Background color
    
    Button color
    
    Animation toggle (on/off)
    
    Include all inline CSS (no external files) and a JS script at the bottom to handle slider behavior and animations.
    Make sure the code is fully responsive, lightweight, and works directly inside a Shopify section.
    
    🪄 Example Add-on You Can Tell AI:
    
    If you want extra features, you can extend your prompt like this:
    
    “Add a gold shimmer hover effect on images.”
    
    “Make the category cards auto-scroll in a slow loop.”
    
    “Add an AI option to dynamically suggest trending categories based on sales.”
    
    “Add a floating diamond sparkle animation around the heading.”
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bf-categories-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
    overflow: hidden;
  }

  .ai-bf-categories-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-bf-categories-heading-{{ ai_gen_id }} {
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 50px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .ai-bf-categories-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  .ai-bf-categories-slider-{{ ai_gen_id }} {
    display: none;
    position: relative;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .ai-bf-categories-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
    gap: 20px;
  }

  .ai-bf-category-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-color: #1a1a1a;
  }

  .ai-bf-category-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
  }

  .ai-bf-category-card-{{ ai_gen_id }} a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-bf-category-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #2a2a2a;
  }

  .ai-bf-category-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-bf-category-card-{{ ai_gen_id }}:hover .ai-bf-category-image-{{ ai_gen_id }} {
    transform: scale(1.1);
  }

  .ai-bf-category-title-{{ ai_gen_id }} {
    padding: 20px;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.card_text_color }};
    letter-spacing: 1px;
    text-transform: uppercase;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
  }

  .ai-bf-slider-controls-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
  }

  .ai-bf-slider-arrow-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: 2px solid {{ block.settings.button_color }};
    background-color: transparent;
    color: {{ block.settings.button_color }};
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-bf-slider-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_color }};
    color: #000000;
  }

  .ai-bf-slider-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-bf-slider-pagination-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
    min-width: 50px;
    text-align: center;
  }

  .ai-bf-view-all-btn-{{ ai_gen_id }} {
    display: block;
    width: fit-content;
    margin: 0 auto;
    padding: 15px 40px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    border-radius: 4px;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_color }};
  }

  .ai-bf-view-all-btn-{{ ai_gen_id }}:hover {
    background-color: transparent;
    color: {{ block.settings.button_color }};
  }

  {% if block.settings.enable_animation %}
    @keyframes ai-bf-fadeUp-{{ ai_gen_id }} {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .ai-bf-animate-{{ ai_gen_id }} {
      opacity: 0;
      animation: ai-bf-fadeUp-{{ ai_gen_id }} 0.8s ease forwards;
    }

    .ai-bf-animate-{{ ai_gen_id }}.ai-bf-visible-{{ ai_gen_id }} {
      animation-play-state: running;
    }
  {% endif %}

  @media screen and (max-width: 1024px) {
    .ai-bf-categories-grid-{{ ai_gen_id }} {
      display: none;
    }

    .ai-bf-categories-slider-{{ ai_gen_id }} {
      display: block;
    }

    .ai-bf-slider-controls-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-bf-category-card-{{ ai_gen_id }} {
      flex: 0 0 calc(33.333% - 14px);
      min-width: calc(33.333% - 14px);
    }
  }

  @media screen and (max-width: 768px) {
    .ai-bf-categories-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-bf-categories-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
      margin-bottom: 30px;
    }

    .ai-bf-category-card-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 10px);
      min-width: calc(50% - 10px);
    }

    .ai-bf-category-title-{{ ai_gen_id }} {
      font-size: 14px;
      padding: 15px;
    }

    .ai-bf-view-all-btn-{{ ai_gen_id }} {
      padding: 12px 30px;
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-bf-categories-{{ ai_gen_id }} {% if block.settings.enable_animation %}ai-bf-animate-{{ ai_gen_id }}{% endif %}" {{ block.shopify_attributes }}>
  <div class="ai-bf-categories-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-bf-categories-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-bf-categories-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% assign category_image_key = 'category_' | append: i | append: '_image' %}
        {% assign category_title_key = 'category_' | append: i | append: '_title' %}
        {% assign category_link_key = 'category_' | append: i | append: '_link' %}
        
        {% assign category_image = block.settings[category_image_key] %}
        {% assign category_title = block.settings[category_title_key] %}
        {% assign category_link = block.settings[category_link_key] %}

        {% if category_title != blank %}
          <div class="ai-bf-category-card-{{ ai_gen_id }}">
            <a href="{{ category_link }}">
              <div class="ai-bf-category-image-wrapper-{{ ai_gen_id }}">
                {% if category_image %}
                  <img
                    src="{{ category_image | image_url: width: 400 }}"
                    alt="{{ category_title | escape }}"
                    class="ai-bf-category-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {% else %}
                  <div class="ai-bf-category-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-bf-category-title-{{ ai_gen_id }}">{{ category_title }}</div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-bf-categories-slider-{{ ai_gen_id }}">
      <div class="ai-bf-categories-slider-track-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% assign category_image_key = 'category_' | append: i | append: '_image' %}
          {% assign category_title_key = 'category_' | append: i | append: '_title' %}
          {% assign category_link_key = 'category_' | append: i | append: '_link' %}
          
          {% assign category_image = block.settings[category_image_key] %}
          {% assign category_title = block.settings[category_title_key] %}
          {% assign category_link = block.settings[category_link_key] %}

          {% if category_title != blank %}
            <div class="ai-bf-category-card-{{ ai_gen_id }}">
              <a href="{{ category_link }}">
                <div class="ai-bf-category-image-wrapper-{{ ai_gen_id }}">
                  {% if category_image %}
                    <img
                      src="{{ category_image | image_url: width: 400 }}"
                      alt="{{ category_title | escape }}"
                      class="ai-bf-category-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  {% else %}
                    <div class="ai-bf-category-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-bf-category-title-{{ ai_gen_id }}">{{ category_title }}</div>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-bf-slider-controls-{{ ai_gen_id }}">
      <button class="ai-bf-slider-arrow-{{ ai_gen_id }} ai-bf-slider-prev-{{ ai_gen_id }}" aria-label="Previous">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <div class="ai-bf-slider-pagination-{{ ai_gen_id }}">
        <span class="ai-bf-current-slide-{{ ai_gen_id }}">1</span>/<span class="ai-bf-total-slides-{{ ai_gen_id }}">1</span>
      </div>
      <button class="ai-bf-slider-arrow-{{ ai_gen_id }} ai-bf-slider-next-{{ ai_gen_id }}" aria-label="Next">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    {% if block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-bf-view-all-btn-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    class BFCategories{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slidesPerView = 3;
        this.totalCards = 0;
      }

      connectedCallback() {
        this.slider = this.querySelector('.ai-bf-categories-slider-{{ ai_gen_id }}');
        this.track = this.querySelector('.ai-bf-categories-slider-track-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-bf-slider-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-bf-slider-next-{{ ai_gen_id }}');
        this.currentSlideEl = this.querySelector('.ai-bf-current-slide-{{ ai_gen_id }}');
        this.totalSlidesEl = this.querySelector('.ai-bf-total-slides-{{ ai_gen_id }}');
        
        if (this.track) {
          this.cards = this.track.querySelectorAll('.ai-bf-category-card-{{ ai_gen_id }}');
          this.totalCards = this.cards.length;
          this.setupSlider();
          this.setupAnimation();
        }
      }

      setupSlider() {
        this.updateSlidesPerView();
        this.updatePagination();
        this.updateButtons();

        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => this.prevSlide());
        }

        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => this.nextSlide());
        }

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.updateSlider();
        });

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.slider.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.slider.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.slider.addEventListener('touchend', () => {
          if (!isDragging) return;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.nextSlide();
            } else {
              this.prevSlide();
            }
          }
          isDragging = false;
        });
      }

      updateSlidesPerView() {
        if (window.innerWidth <= 768) {
          this.slidesPerView = 2;
        } else {
          this.slidesPerView = 3;
        }
      }

      updateSlider() {
        const maxSlide = Math.max(0, this.totalCards - this.slidesPerView);
        if (this.currentSlide > maxSlide) {
          this.currentSlide = maxSlide;
        }

        const cardWidth = this.cards[0].offsetWidth;
        const gap = 20;
        const offset = -(this.currentSlide * (cardWidth + gap));
        
        this.track.style.transform = `translateX(${offset}px)`;
        this.updatePagination();
        this.updateButtons();
      }

      prevSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateSlider();
        }
      }

      nextSlide() {
        const maxSlide = Math.max(0, this.totalCards - this.slidesPerView);
        if (this.currentSlide < maxSlide) {
          this.currentSlide++;
          this.updateSlider();
        }
      }

      updatePagination() {
        const totalSlides = Math.max(1, this.totalCards - this.slidesPerView + 1);
        if (this.currentSlideEl) {
          this.currentSlideEl.textContent = this.currentSlide + 1;
        }
        if (this.totalSlidesEl) {
          this.totalSlidesEl.textContent = totalSlides;
        }
      }

      updateButtons() {
        const maxSlide = Math.max(0, this.totalCards - this.slidesPerView);
        
        if (this.prevBtn) {
          this.prevBtn.disabled = this.currentSlide === 0;
        }
        
        if (this.nextBtn) {
          this.nextBtn.disabled = this.currentSlide >= maxSlide;
        }
      }

      setupAnimation() {
        {% if block.settings.enable_animation %}
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('ai-bf-visible-{{ ai_gen_id }}');
              }
            });
          }, { threshold: 0.1 });

          observer.observe(this);
        {% endif %}
      }
    }

    if (!customElements.get('bf-categories-{{ ai_gen_id }}')) {
      customElements.define('bf-categories-{{ ai_gen_id }}', BFCategories{{ ai_gen_id }});
    }

    const element = document.querySelector('.ai-bf-categories-{{ ai_gen_id }}');
    if (element && element.tagName.toLowerCase() !== 'bf-categories-{{ ai_gen_id }}') {
      const wrapper = document.createElement('bf-categories-{{ ai_gen_id }}');
      element.parentNode.insertBefore(wrapper, element);
      wrapper.appendChild(element);
    }
  })();
</script>

