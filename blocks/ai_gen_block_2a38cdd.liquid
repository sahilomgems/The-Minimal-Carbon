{% doc %}
  @prompt
    Section 1: Hero Banner (Valentine Special)
    Purpose
    
    Create a strong emotional first impression and immediately communicate Valentine’s gifting.
    
    Layout
    
    Full-width hero banner
    
    Desktop + Mobile responsive
    
    Center-focused visual
    
    Visual Concept
    
    Animated GIF or short video
    
    Valentine elements:
    
    Floating heart animation ❤️
    
    Chocolate wrapper opening animation 🍫
    
    Inside the heart: a premium ring for her 💍
    
    Content Elements
    
    Main headline (editable text)
    
    Example: “A Ring That Says ‘I Love You’”
    
    Subheading (optional)
    
    Example: “This Valentine’s Day”
    
    Primary CTA button (editable)
    
    Example: Shop Valentine Collection
    
    Shopify Settings (Editable)
    
    Banner GIF / video upload
    
    Heading text
    
    Subheading text
    
    CTA text + link
    
    Overlay opacity
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-valentine-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-valentine-hero__media-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.mobile_height }}%;
  }

  @media screen and (min-width: 750px) {
    .ai-valentine-hero__media-wrapper-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.desktop_height }}%;
    }
  }

  .ai-valentine-hero__media-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-valentine-hero__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-valentine-hero__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-valentine-hero__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 20px;
    z-index: 2;
  }

  .ai-valentine-hero__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.mobile_heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
    max-width: 90%;
  }

  @media screen and (min-width: 750px) {
    .ai-valentine-hero__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size }}px;
      max-width: 800px;
    }
  }

  .ai-valentine-hero__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.mobile_subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    line-height: 1.4;
    max-width: 90%;
  }

  @media screen and (min-width: 750px) {
    .ai-valentine-hero__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size }}px;
      max-width: 700px;
    }
  }

  .ai-valentine-hero__cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    border-radius: {{ block.settings.button_border_radius }}px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-valentine-hero__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_hover_color }};
    color: {{ block.settings.button_text_hover_color }};
    border-color: {{ block.settings.button_border_hover_color }};
    transform: translateY(-2px);
  }

  .ai-valentine-hero__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-valentine-hero__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .ai-valentine-hero__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<valentine-hero-{{ ai_gen_id }} class="ai-valentine-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-valentine-hero__media-wrapper-{{ ai_gen_id }}">
    {% if block.settings.media_type == 'video' and block.settings.video_url != blank %}
      <video
        class="ai-valentine-hero__video-{{ ai_gen_id }}"
        autoplay
        muted
        loop
        playsinline
        {% if block.settings.video_url contains '.mp4' %}
          src="{{ block.settings.video_url }}"
        {% endif %}
      >
        {% if block.settings.video_url contains '.mp4' %}
          <source src="{{ block.settings.video_url }}" type="video/mp4">
        {% endif %}
      </video>
    {% elsif block.settings.media_type == 'image' and block.settings.banner_image %}
      <img
        src="{{ block.settings.banner_image | image_url: width: 2000 }}"
        alt="{{ block.settings.banner_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.banner_image.width }}"
        height="{{ block.settings.banner_image.height }}"
        class="ai-valentine-hero__media-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-valentine-hero__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-valentine-hero__empty-state-{{ ai_gen_id }}">
          Add a Valentine's banner image or video
        </div>
      </div>
    {% endif %}

    <div class="ai-valentine-hero__overlay-{{ ai_gen_id }}"></div>

    <div class="ai-valentine-hero__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-valentine-hero__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="ai-valentine-hero__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </p>
      {% endif %}

      {% if block.settings.cta_text != blank %}
        <a
          href="{{ block.settings.cta_link }}"
          class="ai-valentine-hero__cta-{{ ai_gen_id }}"
        >
          {{ block.settings.cta_text }}
        </a>
      {% endif %}
    </div>
  </div>
</valentine-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class ValentineHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-valentine-hero__video-{{ ai_gen_id }}');
        if (this.video) {
          this.video.play().catch(function(error) {
            console.log('Video autoplay failed:', error);
          });
        }
      }
    }

    customElements.define('valentine-hero-{{ ai_gen_id }}', ValentineHero{{ ai_gen_id }});
  })();
</script>

