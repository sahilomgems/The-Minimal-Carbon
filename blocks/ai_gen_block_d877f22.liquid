{% doc %}
  @prompt
    Theme:
    Luxury jewelry — sleek, high-end, elegant, and minimal.
    
    Moodboard / Inspiration Keywords:
    
    Black Friday luxury sale
    
    Premium gold accents
    
    Diamond brilliance
    
    Elegant typography
    
    Minimal background (not cluttered)
    
    Colors:
    
    Deep black / charcoal (#000000, #1a1a1a)
    
    Metallic gold (#d4af37 or #c5a300)
    
    White highlights for diamonds and text contrast
    
    Fonts (recommended):
    
    Serif: Playfair Display, Cinzel, or Cormorant Garamond for elegance
    
    Sans-serif for small subtext: Lato or Montserrat
    
    🧠 2. Text Content Layout
    
    Each version should contain:
    
    Main headline: BLACK FRIDAY SALE
    
    Subtext: Up to 50% Off
    
    Optional CTA Button: Shop Now →
    
    Typography layout idea:
    
    “BLACK FRIDAY SALE” — bold, uppercase, large center text
    
    “Up to 50% Off” — smaller below, gold color
    
    “Shop Now” — button-style text, white text on gold rectangle
    
    🪄 3. AI Prompt (Full Version)
    
    Use this prompt exactly (works perfectly in Midjourney, DALL·E, Leonardo AI, or Firefly):
    
    Prompt:
    Create a luxury jewelry-themed Black Friday sale banner for an online Shopify store.
    The design should feature elegant black and gold tones with a subtle gradient background and sparkling diamond jewelry elements (like rings, necklaces, and bracelets) placed tastefully around the edges.
    Include large elegant typography that says: “BLACK FRIDAY SALE” and a smaller subtext “Up to 50% Off”.
    Add a minimal “Shop Now” call-to-action button.
    The overall look should be luxurious, elegant, and clean — not cluttered — with soft lighting and realistic jewelry reflections.
    
    Create 3 size variations:
    
    Desktop: 1920x600 px
    
    Tablet: 768x440 px
    
    Mobile: 393x220 px
    
    Use color palette: black background, gold and white typography, subtle jewelry sparkle, luxury style.
    
    🖼️ 4. Image Dimensions & Composition Tips
    Version	Size (px)	Layout Notes
    Desktop	1920 × 600	Wide composition — place jewelry elements at edges, center text
    Tablet	768 × 440	Balanced layout, tighter crop, text centered
    Mobile	393 × 220	Focus on readability, minimal jewe
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-black-friday-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(135deg, {{ block.settings.bg_color_1 }} 0%, {{ block.settings.bg_color_2 }} 100%);
    min-height: {{ block.settings.banner_height_desktop }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-black-friday-banner-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('{{ block.settings.banner_image | image_url: width: 2000 }}');
    background-size: cover;
    background-position: center;
    opacity: {{ block.settings.image_opacity }};
    z-index: 1;
  }

  .ai-black-friday-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 40px 20px;
    max-width: 1200px;
    width: 100%;
  }

  .ai-black-friday-banner__sparkle-{{ ai_gen_id }} {
    position: absolute;
    width: {{ block.settings.sparkle_size }}px;
    height: {{ block.settings.sparkle_size }}px;
    background: {{ block.settings.sparkle_color }};
    border-radius: 50%;
    opacity: 0;
    animation: ai-sparkle-{{ ai_gen_id }} 3s infinite;
    z-index: 3;
    pointer-events: none;
  }

  @keyframes ai-sparkle-{{ ai_gen_id }} {
    0%, 100% {
      opacity: 0;
      transform: scale(0);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .ai-black-friday-banner__headline-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  .ai-black-friday-banner__subtext-{{ ai_gen_id }} {
    font-family: {{ block.settings.subtext_font.family }}, {{ block.settings.subtext_font.fallback_families }};
    font-weight: {{ block.settings.subtext_font.weight }};
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0 0 30px 0;
    letter-spacing: 2px;
  }

  .ai-black-friday-banner__cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.subtext_font.family }}, {{ block.settings.subtext_font.fallback_families }};
    font-size: {{ block.settings.button_text_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-black-friday-banner__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .ai-black-friday-banner__jewelry-accent-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
    opacity: {{ block.settings.accent_opacity }};
    pointer-events: none;
  }

  .ai-black-friday-banner__jewelry-accent--top-left-{{ ai_gen_id }} {
    top: 20px;
    left: 20px;
    width: {{ block.settings.accent_size }}px;
    height: {{ block.settings.accent_size }}px;
  }

  .ai-black-friday-banner__jewelry-accent--top-right-{{ ai_gen_id }} {
    top: 20px;
    right: 20px;
    width: {{ block.settings.accent_size }}px;
    height: {{ block.settings.accent_size }}px;
  }

  .ai-black-friday-banner__jewelry-accent--bottom-left-{{ ai_gen_id }} {
    bottom: 20px;
    left: 20px;
    width: {{ block.settings.accent_size }}px;
    height: {{ block.settings.accent_size }}px;
  }

  .ai-black-friday-banner__jewelry-accent--bottom-right-{{ ai_gen_id }} {
    bottom: 20px;
    right: 20px;
    width: {{ block.settings.accent_size }}px;
    height: {{ block.settings.accent_size }}px;
  }

  .ai-black-friday-banner__jewelry-accent-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    .ai-black-friday-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.banner_height_tablet }}px;
    }

    .ai-black-friday-banner__headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-black-friday-banner__subtext-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_size }}px * 0.8);
    }

    .ai-black-friday-banner__jewelry-accent-{{ ai_gen_id }} {
      width: calc({{ block.settings.accent_size }}px * 0.7);
      height: calc({{ block.settings.accent_size }}px * 0.7);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-black-friday-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.banner_height_mobile }}px;
    }

    .ai-black-friday-banner__headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.5);
      letter-spacing: {{ block.settings.letter_spacing | times: 0.5 }}px;
    }

    .ai-black-friday-banner__subtext-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_size }}px * 0.7);
      margin-bottom: 20px;
    }

    .ai-black-friday-banner__cta-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_text_size }}px * 0.9);
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }

    .ai-black-friday-banner__jewelry-accent-{{ ai_gen_id }} {
      width: calc({{ block.settings.accent_size }}px * 0.5);
      height: calc({{ block.settings.accent_size }}px * 0.5);
    }

    .ai-black-friday-banner__jewelry-accent--top-left-{{ ai_gen_id }},
    .ai-black-friday-banner__jewelry-accent--top-right-{{ ai_gen_id }} {
      top: 10px;
    }

    .ai-black-friday-banner__jewelry-accent--bottom-left-{{ ai_gen_id }},
    .ai-black-friday-banner__jewelry-accent--bottom-right-{{ ai_gen_id }} {
      bottom: 10px;
    }

    .ai-black-friday-banner__jewelry-accent--top-left-{{ ai_gen_id }},
    .ai-black-friday-banner__jewelry-accent--bottom-left-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-black-friday-banner__jewelry-accent--top-right-{{ ai_gen_id }},
    .ai-black-friday-banner__jewelry-accent--bottom-right-{{ ai_gen_id }} {
      right: 10px;
    }
  }
{% endstyle %}

<div class="ai-black-friday-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_sparkles %}
    {% for i in (1..12) %}
      {% assign sparkle_top = i | times: 8 | modulo: 100 %}
      {% assign sparkle_left = i | times: 13 | modulo: 100 %}
      {% assign sparkle_delay = i | times: 0.2 %}
      <div
        class="ai-black-friday-banner__sparkle-{{ ai_gen_id }}"
        style="top: {{ sparkle_top }}%; left: {{ sparkle_left }}%; animation-delay: {{ sparkle_delay }}s;"
      ></div>
    {% endfor %}
  {% endif %}

  {% if block.settings.show_jewelry_accents %}
    {% if block.settings.accent_image_top_left %}
      <div class="ai-black-friday-banner__jewelry-accent-{{ ai_gen_id }} ai-black-friday-banner__jewelry-accent--top-left-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.accent_image_top_left | image_url: width: 300 }}"
          alt="Jewelry accent"
          loading="lazy"
          width="300"
          height="300"
        >
      </div>
    {% endif %}

    {% if block.settings.accent_image_top_right %}
      <div class="ai-black-friday-banner__jewelry-accent-{{ ai_gen_id }} ai-black-friday-banner__jewelry-accent--top-right-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.accent_image_top_right | image_url: width: 300 }}"
          alt="Jewelry accent"
          loading="lazy"
          width="300"
          height="300"
        >
      </div>
    {% endif %}

    {% if block.settings.accent_image_bottom_left %}
      <div class="ai-black-friday-banner__jewelry-accent-{{ ai_gen_id }} ai-black-friday-banner__jewelry-accent--bottom-left-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.accent_image_bottom_left | image_url: width: 300 }}"
          alt="Jewelry accent"
          loading="lazy"
          width="300"
          height="300"
        >
      </div>
    {% endif %}

    {% if block.settings.accent_image_bottom_right %}
      <div class="ai-black-friday-banner__jewelry-accent-{{ ai_gen_id }} ai-black-friday-banner__jewelry-accent--bottom-right-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.accent_image_bottom_right | image_url: width: 300 }}"
          alt="Jewelry accent"
          loading="lazy"
          width="300"
          height="300"
        >
      </div>
    {% endif %}
  {% endif %}

  <div class="ai-black-friday-banner__content-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h1 class="ai-black-friday-banner__headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h1>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <p class="ai-black-friday-banner__subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </p>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-black-friday-banner__cta-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

