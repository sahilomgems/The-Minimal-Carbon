{% doc %}
  @prompt
    create a one banner option and also look like a crimas style user can change image also use can use gif
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-christmas-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-christmas-banner__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.banner_height }}px;
    display: block;
  }

  .ai-christmas-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-christmas-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-christmas-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-christmas-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-christmas-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-christmas-banner__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
    width: 90%;
    max-width: 800px;
  }

  .ai-christmas-banner__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 700;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .ai-christmas-banner__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 24px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
  }

  .ai-christmas-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  .ai-christmas-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
  }

  .ai-christmas-banner__snowflakes-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .ai-christmas-banner__snowflake-{{ ai_gen_id }} {
    position: absolute;
    top: -10px;
    color: {{ block.settings.snowflake_color }};
    font-size: 20px;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-christmas-banner__image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.banner_height | times: 0.6 }}px;
    }

    .ai-christmas-banner__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.6 }}px;
    }

    .ai-christmas-banner__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.7 }}px;
    }

    .ai-christmas-banner__button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<christmas-banner-{{ ai_gen_id }}
  class="ai-christmas-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-enable-snow="{{ block.settings.enable_snowflakes }}"
>
  <div class="ai-christmas-banner__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.banner_image %}
      <img
        src="{{ block.settings.banner_image | image_url: width: 2000 }}"
        alt="{{ block.settings.banner_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.banner_image.width }}"
        height="{{ block.settings.banner_image.height }}"
        class="ai-christmas-banner__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-christmas-banner__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-christmas-banner__empty-state-{{ ai_gen_id }}">
          Add a festive Christmas image or GIF
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-christmas-banner__overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.enable_snowflakes %}
      <div class="ai-christmas-banner__snowflakes-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-christmas-banner__content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-christmas-banner__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <p class="ai-christmas-banner__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-christmas-banner__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</christmas-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class ChristmasBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.snowflakeSymbols = ['❄', '❅', '❆'];
      }

      connectedCallback() {
        const enableSnow = this.dataset.enableSnow === 'true';
        if (enableSnow) {
          this.createSnowflakes();
        }
      }

      createSnowflakes() {
        const container = this.querySelector('.ai-christmas-banner__snowflakes-{{ ai_gen_id }}');
        if (!container) return;

        const snowflakeCount = 30;

        for (let i = 0; i < snowflakeCount; i++) {
          const snowflake = document.createElement('div');
          snowflake.className = 'ai-christmas-banner__snowflake-{{ ai_gen_id }}';
          snowflake.textContent = this.snowflakeSymbols[Math.floor(Math.random() * this.snowflakeSymbols.length)];

          const startPositionX = Math.random() * 100;
          const animationDuration = 5 + Math.random() * 10;
          const animationDelay = Math.random() * 5;
          const fontSize = 15 + Math.random() * 15;

          snowflake.style.left = startPositionX + '%';
          snowflake.style.fontSize = fontSize + 'px';
          snowflake.style.animation = `ai-snowfall-{{ ai_gen_id }} ${animationDuration}s linear ${animationDelay}s infinite`;

          container.appendChild(snowflake);
        }

        this.addSnowfallAnimation();
      }

      addSnowfallAnimation() {
        const styleSheet = document.createElement('style');
        styleSheet.textContent = `
          @keyframes ai-snowfall-{{ ai_gen_id }} {
            0% {
              transform: translateY(0) rotate(0deg);
              opacity: 0;
            }
            10% {
              opacity: 0.8;
            }
            90% {
              opacity: 0.8;
            }
            100% {
              transform: translateY(100vh) rotate(360deg);
              opacity: 0;
            }
          }
        `;
        document.head.appendChild(styleSheet);
      }
    }

    customElements.define('christmas-banner-{{ ai_gen_id }}', ChristmasBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Christmas banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image or GIF",
      "info": "Upload a festive Christmas image or animated GIF"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Banner height",
      "default": 500
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#165B33"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Overlay opacity",
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Merry Christmas!"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Title size",
      "default": 60
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#FFFFFF"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Celebrate the season with special offers"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Subtitle size",
      "default": 20
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Button text size",
      "default": 16
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#C41E3A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background",
      "default": "#A01729"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Christmas effects"
    },
    {
      "type": "checkbox",
      "id": "enable_snowflakes",
      "label": "Enable falling snowflakes",
      "default": true
    },
    {
      "type": "color",
      "id": "snowflake_color",
      "label": "Snowflake color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Christmas banner"
    }
  ]
}
{% endschema %}