{% doc %}
  @prompt
    
    Create a Black Friday hero banner for a luxury jewelry website.
    Use a black background with subtle gold sparkles or particle animation.
    Text:
    
    Large heading: “BLACK FRIDAY SALE”
    
    Subtext: “Flat 40% OFF on Best Selling Items & 30% OFF on Old Cut Collection.”
    Add two gold buttons side by side:
    
    Button 1: “Shop Best Sellers” → link /collections/best-selling
    
    Button 2: “Shop Old Cuts” → link /collections/old-cut
    Center align everything vertically and horizontally.
    Font color: white and gold (#d4af37).
    Make it mobile responsive and elegant.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bf-hero-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.background_color }};
    min-height: {{ block.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 60px 20px;
  }

  .ai-bf-hero-canvas-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .ai-bf-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .ai-bf-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ai-bf-hero-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0 0 40px;
    line-height: 1.6;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-bf-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ai-bf-hero-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: 1px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    min-width: 200px;
  }

  .ai-bf-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
  }

  @media screen and (max-width: 768px) {
    .ai-bf-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.section_height_mobile }}px;
      padding: 40px 20px;
    }

    .ai-bf-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
      margin-bottom: 15px;
    }

    .ai-bf-hero-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.85 }}px;
      margin-bottom: 30px;
    }

    .ai-bf-hero-buttons-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 15px;
    }

    .ai-bf-hero-button-{{ ai_gen_id }} {
      width: 100%;
      max-width: 300px;
    }
  }
{% endstyle %}

<div class="ai-bf-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <canvas class="ai-bf-hero-canvas-{{ ai_gen_id }}" id="ai-bf-canvas-{{ ai_gen_id }}"></canvas>
  
  <div class="ai-bf-hero-content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-bf-hero-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h1>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="ai-bf-hero-subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

    <div class="ai-bf-hero-buttons-{{ ai_gen_id }}">
      {% if block.settings.button_1_text != blank %}
        <a href="{{ block.settings.button_1_link }}" class="ai-bf-hero-button-{{ ai_gen_id }}">
          {{ block.settings.button_1_text }}
        </a>
      {% endif %}

      {% if block.settings.button_2_text != blank %}
        <a href="{{ block.settings.button_2_link }}" class="ai-bf-hero-button-{{ ai_gen_id }}">
          {{ block.settings.button_2_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function() {
    class BlackFridayHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.canvas = null;
        this.ctx = null;
        this.particles = [];
        this.animationId = null;
      }

      connectedCallback() {
        this.canvas = document.getElementById('ai-bf-canvas-{{ ai_gen_id }}');
        if (!this.canvas) return;

        this.ctx = this.canvas.getContext('2d');
        this.resizeCanvas();
        this.createParticles();
        this.animate();

        window.addEventListener('resize', () => this.resizeCanvas());
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
        window.removeEventListener('resize', () => this.resizeCanvas());
      }

      resizeCanvas() {
        this.canvas.width = this.canvas.offsetWidth;
        this.canvas.height = this.canvas.offsetHeight;
      }

      createParticles() {
        const particleCount = {{ block.settings.particle_count }};
        this.particles = [];

        for (let i = 0; i < particleCount; i++) {
          this.particles.push({
            x: Math.random() * this.canvas.width,
            y: Math.random() * this.canvas.height,
            size: Math.random() * {{ block.settings.particle_max_size }} + {{ block.settings.particle_min_size }},
            speedX: (Math.random() - 0.5) * {{ block.settings.particle_speed }},
            speedY: (Math.random() - 0.5) * {{ block.settings.particle_speed }},
            opacity: Math.random() * 0.5 + 0.3
          });
        }
      }

      animate() {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

        this.particles.forEach(particle => {
          this.ctx.beginPath();
          this.ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
          this.ctx.fillStyle = `rgba(212, 175, 55, ${particle.opacity})`;
          this.ctx.fill();

          particle.x += particle.speedX;
          particle.y += particle.speedY;

          if (particle.x < 0 || particle.x > this.canvas.width) {
            particle.speedX *= -1;
          }
          if (particle.y < 0 || particle.y > this.canvas.height) {
            particle.speedY *= -1;
          }

          particle.opacity += (Math.random() - 0.5) * 0.02;
          particle.opacity = Math.max(0.2, Math.min(0.8, particle.opacity));
        });

        this.animationId = requestAnimationFrame(() => this.animate());
      }
    }

    customElements.define('black-friday-hero-{{ ai_gen_id }}', BlackFridayHero{{ ai_gen_id }});

    const heroElement = document.querySelector('.ai-bf-hero-{{ ai_gen_id }}');
    if (heroElement) {
      const customElement = document.createElement('black-friday-hero-{{ ai_gen_id }}');
      heroElement.appendChild(customElement);
    }
  })();
</script>

