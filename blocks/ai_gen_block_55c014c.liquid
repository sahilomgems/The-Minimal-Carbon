<script>
  (function() {
    class BFCategories{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.itemsPerView = 3;
        this.totalItems = 0;
      }

      connectedCallback() {
        this.slider = this.querySelector('.ai-bf-categories-slider-track-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-bf-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-bf-next-{{ ai_gen_id }}');
        this.currentSpan = this.querySelector('.ai-bf-current-{{ ai_gen_id }}');
        this.totalSpan = this.querySelector('.ai-bf-total-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-bf-categories-slider-{{ ai_gen_id }} .ai-bf-category-card-{{ ai_gen_id }}');

        if (this.slider && this.cards.length > 0) {
          this.totalItems = this.cards.length;
          this.setupSlider();
          this.setupEventListeners();
          this.updatePagination();
          this.updateButtons();
        }

        {% if block.settings.enable_animations %}
        this.setupAnimations();
        {% endif %}
      }

      setupSlider() {
        this.updateItemsPerView();
        window.addEventListener('resize', () => this.updateItemsPerView());
      }

      updateItemsPerView() {
        if (window.innerWidth <= 768) {
          this.itemsPerView = 2;
        } else {
          this.itemsPerView = 3;
        }
        this.updateSliderPosition();
        this.updatePagination();
        this.updateButtons();
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.prev());
        this.nextBtn.addEventListener('click', () => this.next());

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.slider.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.slider.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.slider.addEventListener('touchend', () => {
          if (!isDragging) return;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.next();
            } else {
              this.prev();
            }
          }
          isDragging = false;
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSliderPosition();
          this.updatePagination();
          this.updateButtons();
        }
      }

      next() {
        const maxIndex = Math.ceil(this.totalItems / this.itemsPerView) - 1;
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateSliderPosition();
          this.updatePagination();
          this.updateButtons();
        }
      }

      updateSliderPosition() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = 15;
        const offset = -(this.currentIndex * this.itemsPerView * (cardWidth + gap));
        this.slider.style.transform = `translateX(${offset}px)`;
      }

      updatePagination() {
        const totalPages = Math.ceil(this.totalItems / this.itemsPerView);
        this.currentSpan.textContent = this.currentIndex + 1;
        this.totalSpan.textContent = totalPages;
      }

      updateButtons() {
        const maxIndex = Math.ceil(this.totalItems / this.itemsPerView) - 1;
        this.prevBtn.disabled = this.currentIndex === 0;
        this.nextBtn.disabled = this.currentIndex >= maxIndex;
      }

      {% if block.settings.enable_animations %}
      setupAnimations() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('ai-bf-visible-{{ ai_gen_id }}');
            }
          });
        }, { threshold: 0.1 });

        const animatedElements = this.querySelectorAll('.ai-bf-fade-up-{{ ai_gen_id }}');
        animatedElements.forEach(el => observer.observe(el));
      }
      {% endif %}
    }

    if (!customElements.get('bf-categories-{{ ai_gen_id }}')) {
      customElements.define('bf-categories-{{ ai_gen_id }}', BFCategories{{ ai_gen_id }});
    }

    document.addEventListener('DOMContentLoaded', function() {
      const element = document.querySelector('.ai-bf-categories-{{ ai_gen_id }}');
      if (element && element.parentElement) {
        const wrapper = document.createElement('bf-categories-{{ ai_gen_id }}');
        element.parentElement.insertBefore(wrapper, element);
        wrapper.appendChild(element);
      }
    });
  })();
</script>

