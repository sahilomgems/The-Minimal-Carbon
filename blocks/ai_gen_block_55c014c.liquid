{% doc %}
  @prompt
    Prompt:
    
    Create a Shopify custom section in Liquid, HTML, CSS, and JavaScript named “Black Friday Best Selling Categories”.
    
    The section must:
    
    Theme: Luxury jewelry / Black Friday style — use black and gold colors with subtle gradient tones (#000000 background and #d4af37 gold highlights).
    
    Heading: “Best Selling Items” centered in bold, elegant font (Playfair Display or serif).
    
    Category Cards:
    
    Display 5–6 category cards (Engagement Rings, Wedding Bands, Earrings, Necklaces, Bracelets).
    
    Each card must include an image, title text, and link to a collection (e.g., /collections/best-selling?select_by_product=Engagement+Rings).
    
    The image should fill its container with a square aspect ratio and a light shadow effect.
    
    Responsive Design:
    
    Desktop: show 6 cards in one row (grid).
    
    Tablet: slider view with 3 cards visible and swipe enabled.
    
    Mobile: slider view with 2 cards visible.
    
    Scroll Controls:
    
    Left and right arrow buttons for tablet and mobile.
    
    Pagination text (e.g., “1/2”) that updates when scrolling.
    
    Button: A gold “VIEW ALL” button under the grid that links to /collections/best-selling.
    
    Animations:
    
    Fade-up animation when the section appears on desktop.
    
    Smooth scroll transitions on tablet/mobile.
    
    AI Editor Fields (for Shopify schema):
    
    Editable heading text
    
    Add/remove categories (each with image, title, and link)
    
    Background color
    
    Button color
    
    Animation toggle (on/off)
    
    Include all inline CSS (no external files) and a JS script at the bottom to handle slider behavior and animations.
    Make sure the code is fully responsive, lightweight, and works directly inside a Shopify section.
    
    🪄 Example Add-on You Can Tell AI:
    
    If you want extra features, you can extend your prompt like this:
    
    “Add a gold shimmer hover effect on images.”
    
    “Make the category cards auto-scroll in a slow loop.”
    
    “Add an AI option to dynamically suggest trending categories based on sales.”
    
    “Add a floating diamond sparkle animation around the heading.”
    
    not use box shodow any code
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bf-categories-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    padding: 60px 20px;
    overflow: hidden;
  }

  .ai-bf-categories-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-bf-categories-heading-{{ ai_gen_id }} {
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 50px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .ai-bf-categories-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  .ai-bf-categories-slider-{{ ai_gen_id }} {
    display: none;
    position: relative;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .ai-bf-categories-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
    gap: 15px;
  }

  .ai-bf-category-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.3s ease;
    background: #1a1a1a;
  }

  .ai-bf-category-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-bf-category-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
  }

  .ai-bf-category-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-bf-category-card-{{ ai_gen_id }}:hover .ai-bf-category-image-{{ ai_gen_id }} {
    transform: scale(1.1);
  }

  .ai-bf-category-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-bf-category-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-bf-category-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 100%);
    padding: 20px 15px;
  }

  .ai-bf-category-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    text-align: center;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .ai-bf-slider-controls-{{ ai_gen_id }} {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-bf-slider-arrow-{{ ai_gen_id }} {
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-bf-slider-arrow-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_color }};
    transform: scale(1.1);
  }

  .ai-bf-slider-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-bf-slider-pagination-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    font-weight: 600;
    min-width: 60px;
    text-align: center;
  }

  .ai-bf-view-all-btn-{{ ai_gen_id }} {
    display: inline-block;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    padding: 15px 50px;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 2px;
    border-radius: 4px;
    transition: all 0.3s ease;
    text-align: center;
    margin: 0 auto;
    display: block;
    max-width: 250px;
  }

  .ai-bf-view-all-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  {% if block.settings.enable_animations %}
  .ai-bf-fade-up-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .ai-bf-fade-up-{{ ai_gen_id }}.ai-bf-visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }
  {% endif %}

  @media screen and (max-width: 1024px) {
    .ai-bf-categories-grid-{{ ai_gen_id }} {
      display: none;
    }

    .ai-bf-categories-slider-{{ ai_gen_id }} {
      display: block;
    }

    .ai-bf-slider-controls-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-bf-categories-slider-track-{{ ai_gen_id }} {
      gap: 15px;
    }

    .ai-bf-category-card-{{ ai_gen_id }} {
      min-width: calc(33.333% - 10px);
      flex-shrink: 0;
    }
  }

  @media screen and (max-width: 768px) {
    .ai-bf-categories-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-bf-categories-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
      margin-bottom: 30px;
    }

    .ai-bf-category-card-{{ ai_gen_id }} {
      min-width: calc(50% - 7.5px);
    }

    .ai-bf-category-title-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-bf-view-all-btn-{{ ai_gen_id }} {
      padding: 12px 40px;
      font-size: 14px;
    }
  }
{% endstyle %}

