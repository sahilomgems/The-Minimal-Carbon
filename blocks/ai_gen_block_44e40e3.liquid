{% doc %}
  @prompt
    💎 3. Best Selling Items Section Prompt
    
    Create a Best Selling Items section for a jewelry store.
    Title: “Best Selling Items”
    Below it, display a 4-column grid (responsive) with product cards.
    Each card includes:
    
    Product image (sample placeholder)
    
    Product title
    
    A subtle box shadow and hover zoom-in effect
    
    Button: “View All” (gold button at center below grid).
    Background: pure black, text white, accent color gold (#d4af37).
    Add soft padding around section (60px top and bottom).
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-best-selling-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-best-selling-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-best-selling-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 400;
    letter-spacing: 1px;
  }

  .ai-best-selling-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.button_spacing }}px;
  }

  .ai-best-selling-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-best-selling-card-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
    box-shadow: {{ block.settings.shadow_x | times: 1.5 }}px {{ block.settings.shadow_y | times: 1.5 }}px {{ block.settings.shadow_blur | times: 1.5 }}px {{ block.settings.shadow_color }};
  }

  .ai-best-selling-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-best-selling-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-best-selling-card-{{ ai_gen_id }}:hover .ai-best-selling-image-{{ ai_gen_id }} {
    transform: scale(1.1);
  }

  .ai-best-selling-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-best-selling-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-best-selling-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
  }

  .ai-best-selling-product-title-{{ ai_gen_id }} {
    color: {{ block.settings.product_title_color }};
    font-size: {{ block.settings.product_title_size }}px;
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .ai-best-selling-button-wrapper-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-best-selling-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    letter-spacing: 1px;
    transition: background-color 0.3s ease, transform 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-best-selling-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 989px) {
    .ai-best-selling-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-best-selling-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-best-selling-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-best-selling-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 15px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-best-selling-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-best-selling-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.9 }}px;
    }

    .ai-best-selling-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-best-selling-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-best-selling-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-best-selling-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-best-selling-grid-{{ ai_gen_id }}">
      {% if block.settings.collection != blank %}
        {% for product in block.settings.collection.products limit: block.settings.products_limit %}
          <div class="ai-best-selling-card-{{ ai_gen_id }}">
            <div class="ai-best-selling-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-best-selling-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-best-selling-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-best-selling-card-content-{{ ai_gen_id }}">
              <h3 class="ai-best-selling-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="ai-best-selling-card-{{ ai_gen_id }}">
            <div class="ai-best-selling-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-best-selling-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-best-selling-card-content-{{ ai_gen_id }}">
              <h3 class="ai-best-selling-product-title-{{ ai_gen_id }}">Product {{ i }}</h3>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if block.settings.button_text != blank %}
      <div class="ai-best-selling-button-wrapper-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_link }}" class="ai-best-selling-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

