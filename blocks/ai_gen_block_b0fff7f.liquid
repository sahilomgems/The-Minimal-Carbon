{% doc %}
  @prompt
    💠 8. Popular Jewelry Links Prompt
    
    Create a final section titled “Popular Jewelry”.
    Use a 3-column text grid with category links under headings:
    
    Engagement Ring Elegance
    
    Old Cuts
    
    Diamond Cuts
    
    Loose Diamonds
    
    Color Diamonds
    Each link should be white text that turns gold on hover.
    Background: slightly darker black than previous section for contrast.
    Font size: 14px, spacing comfortable.
    
    ⚙ Optional Enhancement Prompts
    ✨ Glow Background Prompt
    
    Add subtle gold sparkle or particle effect animation to the background of the hero section for a premium luxury Black Friday vibe.
    
    🎨 Color Palette Prompt
    
    Use a consistent color palette:
    
    Background: #000000
    
    Text: #ffffff
    
    Accent (Gold): #d4af37
    
    Secondary (Red for discount tags): #ff4c4c
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-popular-jewelry-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
    position: relative;
    overflow: hidden;
  }

  {% if block.settings.enable_sparkle %}
    .ai-sparkle-canvas-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }
  {% endif %}

  .ai-popular-jewelry-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .ai-popular-jewelry-title-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin-bottom: {{ block.settings.title_margin }}px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .ai-popular-jewelry-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-popular-jewelry-column-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-popular-jewelry-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin-bottom: {{ block.settings.heading_margin }}px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .ai-popular-jewelry-links-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-popular-jewelry-link-item-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.link_spacing }}px;
  }

  .ai-popular-jewelry-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.link_size }}px;
    text-decoration: none;
    transition: color 0.3s ease;
    display: inline-block;
  }

  .ai-popular-jewelry-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-popular-jewelry-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-popular-jewelry-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-popular-jewelry-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

