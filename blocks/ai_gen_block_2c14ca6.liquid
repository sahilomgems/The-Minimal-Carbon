{% doc %}
  @prompt
    Section 3: Valentine Collections (4 Clickable Collections)
    Purpose
    
    Highlight curated Valentine collections and drive category-level shopping.
    
    Layout
    
    Grid: 4 collection cards
    
    Equal spacing
    
    Hover animation (zoom / glow)
    
    Collection Behavior
    
    Each card:
    
    Clickable
    
    Linked to selected Shopify collection
    
    Fully editable by admin
    
    Suggested Collection Names
    
    Her Heart Collection
    
    Forever Promise Rings
    
    Sweet Valentine Gifts
    
    Love Sparkle Edition
    
    Shopify Settings (Editable)
    
    Select collection (collection picker)
    
    Upload / replace image
    
    Collection title override
    
    Button label
    
    Valentine Image Concepts (Ready to Generate)
    
    You can generate or upload images based on these concepts:
    
    Romantic pink background, heart petals floating, diamond ring in center
    
    Rose-red silk fabric background with soft lighting and ring box
    
    Minimal white & blush background with heart-shaped shadow and ring
    
    Luxury velvet red background with golden light and engagement ring
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-valentine-collections-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-valentine-collections__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-valentine-collections__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-valentine-collections__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-valentine-collections__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-valentine-collections__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-valentine-collection-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: block;
    text-decoration: none;
  }

  .ai-valentine-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }

  .ai-valentine-collection-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-valentine-collection-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-valentine-collection-card-{{ ai_gen_id }}:hover .ai-valentine-collection-card__image-{{ ai_gen_id }} {
    transform: scale(1.1);
  }

  .ai-valentine-collection-card__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.6) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-valentine-collection-card-{{ ai_gen_id }}:hover .ai-valentine-collection-card__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-valentine-collection-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
  }

  .ai-valentine-collection-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .ai-valentine-collection-card-{{ ai_gen_id }}:hover .ai-valentine-collection-card__title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_hover_color }};
  }

  .ai-valentine-collection-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_background }};
  }

  .ai-valentine-collection-card-{{ ai_gen_id }}:hover .ai-valentine-collection-card__button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_background }};
  }

  .ai-valentine-collection-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-valentine-collection-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-valentine-collection-card__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #999;
    text-align: center;
    white-space: nowrap;
  }

  @media screen and (max-width: 989px) {
    .ai-valentine-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-valentine-collections__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-valentine-collection-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-valentine-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-valentine-collections-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-valentine-collections__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-valentine-collection-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-valentine-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-valentine-collections__container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-valentine-collections__header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-valentine-collections__title-{{ ai_gen_id }}">
            {{ block.settings.section_title }}
          </h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-valentine-collections__subtitle-{{ ai_gen_id }}">
            {{ block.settings.section_subtitle }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-valentine-collections__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign title_key = 'collection_' | append: i | append: '_title'
          assign button_key = 'collection_' | append: i | append: '_button_label'
          
          assign collection = block.settings[collection_key]
          assign custom_title = block.settings[title_key]
          assign button_label = block.settings[button_key]
        %}

        {% if collection != blank %}
          <a 
            href="{{ collection.url }}" 
            class="ai-valentine-collection-card-{{ ai_gen_id }}"
            aria-label="View {{ collection.title }} collection"
          >
            <div class="ai-valentine-collection-card__image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-valentine-collection-card__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
              {% else %}
                <div class="ai-valentine-collection-card__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-valentine-collection-card__overlay-{{ ai_gen_id }}"></div>
            </div>
            <div class="ai-valentine-collection-card__content-{{ ai_gen_id }}">
              <h3 class="ai-valentine-collection-card__title-{{ ai_gen_id }}">
                {% if custom_title != blank %}
                  {{ custom_title }}
                {% else %}
                  {{ collection.title }}
                {% endif %}
              </h3>
              <span class="ai-valentine-collection-card__button-{{ ai_gen_id }}">
                {{ button_label }}
              </span>
            </div>
          </a>
        {% else %}
          <div class="ai-valentine-collection-card-{{ ai_gen_id }}" style="cursor: default; pointer-events: none;">
            <div class="ai-valentine-collection-card__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-valentine-collection-card__placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
                <div class="ai-valentine-collection-card__empty-state-{{ ai_gen_id }}">
                  Select a collection
                </div>
              </div>
            </div>
            <div class="ai-valentine-collection-card__content-{{ ai_gen_id }}">
              <h3 class="ai-valentine-collection-card__title-{{ ai_gen_id }}">
                {% if custom_title != blank %}
                  {{ custom_title }}
                {% else %}
                  Collection {{ i }}
                {% endif %}
              </h3>
              <span class="ai-valentine-collection-card__button-{{ ai_gen_id }}">
                {{ button_label }}
              </span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

