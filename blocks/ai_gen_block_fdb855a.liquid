{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-valentine-collections-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-valentine-collections__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-valentine-collections__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-valentine-collections__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-valentine-collections__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-valentine-collections__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-valentine-collections__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    aspect-ratio: 1 / 1.2;
    transition: transform 0.3s ease;
  }

  .ai-valentine-collections__item-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
  }

  .ai-valentine-collections__link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-valentine-collections__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-valentine-collections__item-{{ ai_gen_id }}:hover .ai-valentine-collections__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-valentine-collections__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    padding: 30px 20px;
    transition: background 0.3s ease;
  }

  .ai-valentine-collections__item-{{ ai_gen_id }}:hover .ai-valentine-collections__overlay-{{ ai_gen_id }} {
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  }

  .ai-valentine-collections__name-{{ ai_gen_id }} {
    color: {{ block.settings.collection_name_color }};
    font-size: {{ block.settings.collection_name_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .ai-valentine-collections__count-{{ ai_gen_id }} {
    color: {{ block.settings.collection_count_color }};
    font-size: {{ block.settings.collection_count_size }}px;
    margin: 0;
  }

  .ai-valentine-collections__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-valentine-collections__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    .ai-valentine-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-valentine-collections__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-valentine-collections__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-valentine-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-valentine-collections__name-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_name_size | times: 0.8 }}px;
    }

    .ai-valentine-collections__count-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_count_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<valentine-collections-{{ ai_gen_id }} class="ai-valentine-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-valentine-collections__container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-valentine-collections__header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-valentine-collections__title-{{ ai_gen_id }}">
            {{ block.settings.section_title }}
          </h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-valentine-collections__subtitle-{{ ai_gen_id }}">
            {{ block.settings.section_subtitle }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-valentine-collections__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        <div class="ai-valentine-collections__item-{{ ai_gen_id }}">
          {% if collection != blank %}
            <a href="{{ collection.url }}" class="ai-valentine-collections__link-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.title | escape }}"
                  class="ai-valentine-collections__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="720"
                >
              {% else %}
                <div class="ai-valentine-collections__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              <div class="ai-valentine-collections__overlay-{{ ai_gen_id }}">
                <h3 class="ai-valentine-collections__name-{{ ai_gen_id }}">
                  {{ collection.title }}
                </h3>
                {% if block.settings.show_product_count %}
                  <p class="ai-valentine-collections__count-{{ ai_gen_id }}">
                    {{ collection.products_count }} 
                    {% if collection.products_count == 1 %}
                      product
                    {% else %}
                      products
                    {% endif %}
                  </p>
                {% endif %}
              </div>
            </a>
          {% else %}
            <div class="ai-valentine-collections__link-{{ ai_gen_id }}">
              <div class="ai-valentine-collections__placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
              <div class="ai-valentine-collections__overlay-{{ ai_gen_id }}">
                <h3 class="ai-valentine-collections__name-{{ ai_gen_id }}">
                  Collection {{ i }}
                </h3>
                {% if block.settings.show_product_count %}
                  <p class="ai-valentine-collections__count-{{ ai_gen_id }}">
                    0 products
                  </p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</valentine-collections-{{ ai_gen_id }}>

<script>
  (function() {
    class ValentineCollections{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('valentine-collections-{{ ai_gen_id }}', ValentineCollections{{ ai_gen_id }});
  })();
</script>

